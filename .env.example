# Set server-side in Vercel. Never use PUBLIC_ prefixes. Keep access off until launch checks pass.
ACCESS_ENABLED=false
APP_ORIGIN=https://digivated.vercel.app
GUMROAD_PRODUCT_ID=ELdVVW1-tlMwQyuADA6C0A==
# Generate a NEW random 32-byte hex secret separately for preview and production.
SESSION_SECRET=
# Existing edition decryption key from private owner access file. Never send to buyers.
EDITION_KEY=
# Only honored with VERCEL_ENV=preview. Never enable for production.
ALLOW_TEST_PURCHASES=false

# Optional public visitor card: Google Analytics 4 read-only reporting.
# Grant the service account Viewer access to this property; enable the Data API.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
