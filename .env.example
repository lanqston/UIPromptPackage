# Set server-side in Vercel. Never use PUBLIC_ prefixes. Keep access off until launch checks pass.
ACCESS_ENABLED=false
APP_ORIGIN=https://digivated.com
GUMROAD_PRODUCT_ID=ELdVVW1-tlMwQyuADA6C0A==
# Generate a NEW random 32-byte hex secret separately for preview and production.
SESSION_SECRET=
# Existing edition decryption key from private owner access file. Never send to buyers.
EDITION_KEY=
# Only honored with VERCEL_ENV=preview. Never enable for production.
ALLOW_TEST_PURCHASES=false

# Optional public visitor card: Google Analytics 4 read-only reporting.
# Grant the service account Viewer access to this property; enable the Data API.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Educational carousels. Publishing writes to the existing submissions Redis.
# Generate a new 32-byte hex secret. Leave it unset until you are ready to publish.
CAROUSEL_PUBLISH_SECRET=
# Keep founding member sign-in off while the Gumroad product is an unpublished draft.
FOUNDING_ACCESS_ENABLED=false
# Gumroad product id for the Founding Member Pass. Must not be the Prompt Packet id.
FOUNDING_GUMROAD_PRODUCT_ID=
# Separate 32-byte hex secret. Do not reuse SESSION_SECRET.
FOUNDING_SESSION_SECRET=
# Seller token with view_sales, used only to match a purchase email. Server-only.
FOUNDING_GUMROAD_ACCESS_TOKEN=
# Only honored with VERCEL_ENV=preview. Never enable for production.
FOUNDING_ALLOW_TEST_PURCHASES=false
# Mailing address shown in optional weekly project emails. Sending stays off until set.
WEEKLY_EMAIL_POSTAL_ADDRESS=
WEEKLY_EMAIL_FROM=
