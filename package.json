{
  "name": "ui-prompt-package",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-launch-template.mjs",
    "preview": "astro preview",
    "verify:content": "node scripts/verify-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node --check src/scripts/app.js && node --check server/access.mjs && node --check server/handler.mjs",
    "monitoring:deploy": "node scripts/deploy-monitoring.mjs"
  },
  "dependencies": {
    "@sentry/browser": "11.6.0",
    "@sentry/node": "11.6.0",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/firewall": "^1.2.6",
    "astro": "7.3.8",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "checkly": "^9.5.0",
    "tailwindcss": "4.3.3"
  }
}
