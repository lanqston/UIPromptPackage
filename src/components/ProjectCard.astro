---
import { safeUrl } from '../data/community.mjs';
const { project } = Astro.props;
---
<article class="project-card" data-project data-category={project.category} data-featured={String(project.status==='featured')} data-pick={String(project.pick===true)} data-search={`${project.name} ${project.creator} ${project.description} ${project.category}`.toLowerCase()}>
<div class="project-image">{project.image?.startsWith('/community/') ? <img src={project.image} alt={`${project.name} project preview`} loading="lazy" width="640" height="400"/> : <span class="tiny">{project.category}</span>}</div>
<div class="project-copy"><span class="tag">{project.category}</span><h3>{project.name}</h3><p class="quiet">By {project.creator}</p><p>{project.description}</p><div class="card-links"><a href={safeUrl(project.url)} target="_blank" rel="noopener noreferrer">Visit Project ↗</a>{safeUrl(project.socialUrl)&&<a href={safeUrl(project.socialUrl)} target="_blank" rel="noopener noreferrer">Creator ↗</a>}</div></div>
</article>
