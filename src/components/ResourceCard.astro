---
import { normalizeResourceCategory } from '../data/community.mjs';
const { resource } = Astro.props;
const category = normalizeResourceCategory(resource.category);
---
<article class="resource-card" data-resource data-builtin-resource data-resource-url={`/resources/${resource.slug}`} data-category={category} data-search={`${resource.title} ${resource.description} ${category}`.toLowerCase()}>{resource.coverImage&&<img src={resource.coverImage} alt="" width="640" height="360" loading="lazy"/>}<span class="tag">{category}</span><h3><a href={`/resources/${resource.slug}`}>{resource.title}</a></h3><p>{resource.description}</p><p class="quiet"><time datetime={resource.date}>{resource.date}</time> · {resource.readingTime} min read</p><a class="button" href={`/resources/${resource.slug}`}>Read the guide</a><button class="button" type="button" data-save-type="resource" data-save-id={resource.slug}>Save</button></article>

