---
import { normalizeResourceCategory } from '../data/community.mjs';
import { cardIconMarkup } from '../lib/card-icons.mjs';
const { resource } = Astro.props;
const category = normalizeResourceCategory(resource.category);
const url = `/resources/${resource.slug}`;
const topic = category.toLowerCase().replace(/[^a-z0-9]+/g,'-');
---
<article class="resource-card" data-resource data-builtin-resource data-resource-view-id={resource.slug} data-resource-url={url} data-category={category} data-search={`${resource.title} ${resource.description} ${category}`.toLowerCase()}>
  <div class="resource-copy"><span class="tag">{category}</span><h3><a href={url}>{resource.title}</a></h3><p class="resource-description">{resource.description}</p><p class="resource-meta"><time datetime={resource.date}>{resource.date}</time> · {resource.readingTime} min read <span aria-hidden="true">·</span> <span data-resource-views={resource.slug} title="Approximate resource views on Digivated. Repeat views from the same network count once every 24 hours.">0 views</span></p><a class="card-open" href={url}>Read the guide <span aria-hidden="true">↗</span></a><div class="card-actions">
      <button class="card-icon" type="button" data-comment-type="resource" data-comment-id={resource.slug} aria-label={`Read or leave a comment on ${resource.title}`} title="Comments"><span set:html={cardIconMarkup('comment')}/><span class="sr-only">Comments</span></button>
      <button class="card-icon" type="button" data-share-url={url} aria-label={`Share ${resource.title}`} title="Share"><span set:html={cardIconMarkup('share')}/><span class="sr-only">Share</span></button>
      <button class="card-icon" type="button" data-like-type="resource" data-like-id={resource.slug} aria-label={`Like ${resource.title}`} title="Like"><span set:html={cardIconMarkup('like')}/><span class="card-count" data-like-count></span></button>
      <button class="card-icon card-save" type="button" data-save-type="resource" data-save-id={resource.slug} aria-label="Save to collection" title="Save to collections"><span set:html={cardIconMarkup('save')}/><span class="sr-only" data-save-label>Save</span></button>
    </div></div>
</article>

