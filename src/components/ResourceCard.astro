---
import { normalizeResourceCategory } from '../data/community.mjs';
import { cardIconMarkup } from '../lib/card-icons.mjs';
import { categoryIcon } from '../lib/card-meta.mjs';
import CardStats from './CardStats.astro';
import CardActions from './CardActions.astro';
const { resource } = Astro.props;
const category = normalizeResourceCategory(resource.category);
const id = resource.id || resource.slug;
const url = resource.url || `/resources/${resource.slug}`;
---
<article class="resource-card" data-resource data-resource-name={resource.title} data-resource-date={resource.date || ''} data-resource-reading-time={resource.readingTime || ''} data-resource-kind={resource.packet ? 'toolkit' : 'guide'} data-builtin-resource data-resource-view-id={id} data-resource-url={url} data-category={category} data-search={`${resource.title} ${resource.description} ${category} ${resource.packet ? 'promptpackage prompts toolkit' : ''}`.toLowerCase()}>
  <div class="resource-copy">
    <div class="card-topic"><span class="topic-icon" set:html={cardIconMarkup(categoryIcon(category))}/><span class="tag">{category}</span></div>
    <h3><a href={url}>{resource.title}</a></h3>
    <p class="resource-description">{resource.description}</p>
    <CardStats resource={{ ...resource, id }}/>
    <div class="card-footer">
      <CardActions id={id} title={resource.title} url={url}/>
      <a class="card-open" href={url}><span>{resource.packet ? 'Explore the packet' : 'Read the guide'}</span><span class="button-arrow" set:html={cardIconMarkup('arrow')}/></a>
    </div>
  </div>
</article>

