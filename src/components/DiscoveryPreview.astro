---
import LiveProjects from './LiveProjects.astro';
import UiIcon from './UiIcon.astro';
import { projectCategories } from '../data/community.mjs';
---
<section class="notebook-browser" id="explore-projects" aria-labelledby="preview-title">
  <div class="notebook-browser-chrome"><span class="notebook-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>digivated.com / discover</span><a href="/discover" aria-label="Open the full project directory"><UiIcon size={16}/></a></div>
  <div class="notebook-browser-body">
    <header class="notebook-browser-heading"><div><p class="notebook-overline">THE PROJECT DIRECTORY</p><h2 id="preview-title">Something worth exploring.</h2><p>Discover what independent builders are making.</p></div><a class="button notebook-submit" href="/submit-project"><UiIcon name="upload" size={16}/> Submit a project</a></header>
    <div class="notebook-browser-toolbar" data-directory="projects"><label class="notebook-search"><span class="sr-only">Search projects</span><UiIcon name="search"/><input id="directory-search" type="search" placeholder="Find a project, tool, or idea"/></label><label><span class="sr-only">Category</span><select id="directory-category"><option value="">All categories</option>{projectCategories.map(c=><option>{c}</option>)}</select></label><select id="directory-view" aria-label="Collection" hidden><option value="featured">Featured</option><option value="newest">All projects</option></select><select id="directory-sort" aria-label="Sort projects" hidden><option value="newest">Newest first</option></select></div>
    <div class="notebook-browser-tabs"><div role="group" aria-label="Project collections"><button type="button" data-directory-view="featured" aria-pressed="true">Featured</button><button type="button" data-directory-view="newest" aria-pressed="false">All projects</button></div><p id="directory-status" role="status">Loading projects…</p><button data-directory-clear type="button" hidden>Clear filters</button></div>
    <h3 id="directory-heading" class="sr-only">Featured projects</h3>
    <div class="notebook-project-window" tabindex="0" aria-label="Browse the project directory"><div class="notebook-skeleton" aria-hidden="true">{[1,2,3].map(()=><div><i></i><b></b><span></span><span></span></div>)}</div><LiveProjects mode="all" directory compact title="The next discovery is still to come." description="Reviewed projects will appear here." href="/submit-project" label="Submit your project"/></div>
    <a class="notebook-directory-link" href="/discover">Explore the full directory <UiIcon size={16}/></a>
  </div>
</section>
