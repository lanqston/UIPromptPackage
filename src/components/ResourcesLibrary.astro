---
import { cardIconMarkup } from '../lib/card-icons.mjs';
import { resourceGuides } from '../data/home-content.mjs';
---
<section id="resources" class="home-section resource-library" aria-labelledby="resources-heading">
  <div class="home-section-heading flex flex-wrap items-end justify-between gap-5"><div><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> CHOOSE A LEARNING GOAL</p><h2 id="resources-heading">What would you like to learn?</h2><p>Pick a goal to see a focused set of guides in a suggested order.</p></div><a class="section-link" href="/resources">The full library <span aria-hidden="true">↗</span></a></div>
  <div class="topic-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {resourceGuides.map((guide,index) => <article class="idea-card rounded-xl border border-brand-line bg-brand-card overflow-hidden"><div class="idea-copy p-6"><div class="idea-identity"><span class="idea-symbol" aria-hidden="true" set:html={cardIconMarkup(guide.icon)}></span><span class="idea-index" aria-hidden="true">0{index+1}</span></div><span class="tag">{guide.category}</span><h3><a href={guide.href}>{guide.title}</a></h3><p>{guide.description}</p><a class="idea-link" href={guide.href}>{guide.label} <span aria-hidden="true">→</span></a></div></article>)}
  </div>
</section>

