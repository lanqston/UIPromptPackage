---
import EmptyState from './EmptyState.astro';
const { mode='all', title, description, href, label, compact=false, limit=0, directory=false, filterable=false }=Astro.props;
---
<div data-live-projects={mode} data-limit={limit} data-project-filters={filterable || undefined} aria-busy={filterable ? 'true' : undefined}>
{filterable && <div class="project-browse-header"><div class="build-filters" role="group" aria-label="Filter community projects">{[['all', 'All'], ['featured', 'Featured'], ['picks', 'Digivated Picks']].map(([value, text]) => <button type="button" data-project-filter={value} aria-pressed={value === 'all' ? 'true' : 'false'} aria-controls="community-project-list" disabled>{text}</button>)}</div><p class="quiet project-result-count" data-live-status role="status">Loading projects…</p><p class="project-filter-description" data-filter-description>Browse the latest projects from independent creators.</p></div>}
<div class:list={[mode==='all'?'project-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6':'']} data-live-list id={filterable ? 'community-project-list' : undefined} hidden></div><div data-live-empty id={directory?'directory-empty':undefined}><EmptyState title={title} description={description} href={href} label={label} compact={compact}/></div>{!filterable && <p class="quiet" data-live-status role="status"></p>}<noscript><p class="quiet">Enable JavaScript to load reviewed community projects.</p></noscript></div>

