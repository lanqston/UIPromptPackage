---
const { product } = Astro.props;
---
<article class:list={['product-feature', { 'product-feature--focus-city': product.visual === 'city' }]}>
  <div class="product-art">
    {product.visual === 'city'
      ? <div class="focus-city-art"><span class="focus-city-art-label">DIGIVATED · FOCUS APP</span><img src={product.image} alt="Illustration of a glowing Focus City skyline" width="360" height="400" loading="lazy"/><span class="focus-city-art-title">FOCUS CITY</span></div>
      : <div class="product-art-cover"><span class="product-art-eyebrow">DIGIVATED · DIGITAL TOOLKIT</span><img src={product.image} alt="Digivated mark" width="220" height="290" loading="lazy"/><span class="product-art-title">THE UI/UX<br/>PROMPT PACKET</span></div>}
    <span class="tiny">{product.visual === 'city' ? 'Make time. Build your world.' : 'A practical playbook for your next idea'}</span>
  </div>
  <div class="product-copy"><p class="eyebrow">Made by Digivated</p><h2>{product.name}</h2><p class="lede">{product.description}</p><p class="quiet">{product.label}</p><ul class="product-benefits">{product.benefits.map(benefit => <li>{benefit}</li>)}</ul><a class="button primary" href={product.url} target={product.external ? '_blank' : undefined} rel={product.external ? 'noopener noreferrer' : undefined}>{product.external ? 'Open' : 'View'} {product.name} {product.external && <span aria-hidden="true">↗</span>}</a>{!product.external && <p class="quiet product-return"><a href="/access">Already purchased? Open your packet</a></p>}</div>
</article>

