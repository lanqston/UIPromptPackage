---
const { product } = Astro.props;
---
<article class="product-feature"><div class="product-art"><div class="product-art-cover"><span class="product-art-eyebrow">DIGIVATED · DIGITAL TOOLKIT</span><img src={product.image} alt="Digivated mark" width="220" height="290" loading="lazy"/><span class="product-art-title">THE UI/UX<br/>PROMPT PACKET</span></div><span class="tiny">A practical playbook for your next idea</span></div><div class="product-copy"><p class="eyebrow">Made by Digivated</p><h2>{product.name}</h2><p class="lede">{product.description}</p><p class="quiet">{product.label}</p><ul class="product-benefits"><li>Customizable prompt builder</li><li>Step-by-step guidance</li><li>Website &amp; app planning</li></ul><a class="button primary" href={product.url}>View {product.name}</a><p class="quiet product-return"><a href="/access">Already purchased? Open your packet</a></p></div></article>

