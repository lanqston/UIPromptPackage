---
const { product } = Astro.props;
---
<article class="product-feature"><div class="product-art"><img src={product.image} alt="Digivated" width="300" height="300" loading="lazy"/><span class="tiny">A practical playbook for your next idea</span></div><div class="product-copy"><p class="eyebrow">Made by Digivated</p><h2>{product.name}</h2><p class="lede">{product.description}</p><p class="quiet">{product.label}</p><a class="button primary" href={product.url}>View {product.name} <span aria-hidden="true">↗</span></a><p class="quiet product-return"><a href="/access">Already purchased? Open your packet →</a></p></div></article>
