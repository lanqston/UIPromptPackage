---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const features = [
  ['/resources','Resources','Free previews and learning resources'],
  ['/discover','Projects','Discover independent work'],
  ['/submit-project','Submit a project','Share your work for free review'],
];
const paidOptions = [
  ['/founding-members','Founding Membership','$5 once · Carousels, packet, and one reviewed feature'],
  ['/ui-ux-prompt-packet','UI/UX Prompt Packet','$4 once · 75 prompts, workflows, and checklists'],
  ['/promote','Featured project spot','$3 once · One promotional request, reviewed'],
];
const active = (href: string) => path === href || path.startsWith(href + '/') || (href === '/discover' && path.startsWith('/projects/'));
---
<header class="platform-header compact-site-header">
  <div class="header-inner">
    <a class="platform-brand" href="/" aria-label="Digivated home"><span class="x-brand-mark" aria-hidden="true"></span><span>Digivated</span></a>
    <div class="compact-header-actions">
      <button class="header-search" type="button" data-open-search aria-label="Search Digivated"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
      <details class="explore-menu"><summary aria-controls="explore-navigation"><span>Explore</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <nav id="explore-navigation" aria-label="Main navigation"><p class="explore-label">Browse for free</p><div class="explore-features">{features.map(([href,label,description])=><a href={href} aria-current={active(href)?'page':undefined}><span><strong>{label}</strong><small>{description}</small></span><span aria-hidden="true">→</span></a>)}</div><section class="explore-paid" aria-labelledby="paid-options-title"><h2 class="explore-label" id="paid-options-title">Paid options</h2><div class="explore-features">{paidOptions.map(([href,label,description])=><a href={href} aria-current={active(href)?'page':undefined}><span><strong>{label}</strong><small>{description}</small></span><span aria-hidden="true">→</span></a>)}</div></section><a class="explore-member-access" href="/founding-members#member-sign-in">Member access →</a><div class="explore-utilities"><a href="/account">Your projects</a><a href="/access">Packet access</a><a href="/saved">Saved items</a><a href="/about">About</a></div></nav>
      </details>
    </div>
  </div>
</header>
