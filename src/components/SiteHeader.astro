---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/resources', 'Resources'], ['/discover', 'Projects'], ['/products', 'Products'], ['/about', 'About']];
const active = (href: string) => (href === '/discover' && (path.startsWith('/projects/') || path === '/launch-template')) || path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="platform-header fixed inset-x-0 top-0 z-50 border-b border-brand-line bg-brand-bg">
  <div class="header-inner mx-auto flex items-center justify-between gap-6 px-6">
    <a class="platform-brand shrink-0" href="/" aria-label="Digivated home"><span class="x-brand-mark" aria-hidden="true"></span><span>Digivated</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
    <button class="header-search" type="button" data-open-search aria-label="Search Digivated"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><kbd>⌘ K</kbd></button>
    <div class="header-actions"><a class="header-sign-in" href="/saved">Saved items</a><a class="button primary header-submit" href="/submit-project">Submit a project <span aria-hidden="true">↗</span></a></div>
    <details class="mobile-menu"><summary aria-controls="platform-mobile-navigation"><span>Menu</span><span class="menu-glyph" aria-hidden="true"></span></summary><nav id="platform-mobile-navigation" aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}<a href="/submit-project" aria-current={active('/submit-project')?'page':undefined}>Submit a project</a><a href="/saved">Saved items</a><a href="/access">Open purchased packet</a><a href="/promote">Promote a project</a></nav></details>
  </div>
</header>

