---
import UiIcon from './UiIcon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const features = [
  ['/discover','Projects','Discover independent work'],
  ['/resources','Resources','Read practical guides and news'],
  ['/carousels','Carousels','Quick visual explainers'],
  ['/submit-project','Submit a project','Share your work for free review'],
];
const paidOptions = [
  ['/founding-members','Founding Membership','$5 once · Carousels, packet, and one reviewed feature'],
  ['/ui-ux-prompt-packet','UI/UX Prompt Packet','$4 once · 75 prompts, workflows, and checklists'],
  ['/promote','Featured project spot','$3 once · One promotional request, reviewed'],
];
const active = (href: string) => path === href || path.startsWith(href + '/') || (href === '/discover' && path.startsWith('/projects/'));
---
<header class="platform-header compact-site-header">
  <div class="header-inner">
    <a class="platform-brand" href="/" aria-label="Digivated home"><span class="x-brand-mark" aria-hidden="true"></span><span>Digivated</span></a>
    <nav class="header-primary" aria-label="Primary navigation">{features.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
    <div class="compact-header-actions">
      <button class="header-search" type="button" data-open-search aria-label="Search Digivated"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
      <a class="header-login" id="header-account-link" href="/login" aria-current={active('/login')?'page':undefined}>Log In</a>
      <details class="explore-menu notebook-navigation" data-navigation>
        <summary aria-controls="explore-navigation" aria-label="Open navigation menu" aria-expanded="false"><span class="navigation-trigger-label">Explore</span><span class="navigation-trigger-chevron"><UiIcon name="chevron" size={16}/></span><span class="navigation-trigger-menu"><UiIcon name="menu" size={21}/></span><span class="navigation-trigger-close"><UiIcon name="close" size={21}/></span></summary>
        <nav id="explore-navigation" class="navigation-panel" aria-label="Explore Digivated">
          <div class="navigation-panel-grid">
            <section class="navigation-main" aria-labelledby="navigation-explore-title"><h2 id="navigation-explore-title">Explore Digivated</h2>
              <div class="navigation-destinations">{features.map(([href,label,description],index)=><a href={href} aria-current={active(href)?'page':undefined}><span class="navigation-icon"><UiIcon name={['grid','book','layers','upload'][index]} size={20}/></span><span class="navigation-link-copy"><strong>{label}</strong><small>{description}</small></span><span class="navigation-link-arrow"><UiIcon size={16}/></span></a>)}</div>
            </section>
            <section class="navigation-builder" aria-labelledby="navigation-builder-title"><h2 id="navigation-builder-title">For builders</h2>
              <a class="navigation-feature" href="/submit-project"><span class="navigation-feature-art" aria-hidden="true"><UiIcon name="upload" size={26}/><span class="navigation-feature-line"></span><span class="navigation-feature-line short"></span></span><strong>Made something good?</strong><span>Give your project a place to be discovered.</span><b>Submit for free <UiIcon size={15}/></b></a>
              <details class="navigation-products"><summary>Products & paid options <UiIcon name="chevron" size={14}/></summary><div>{paidOptions.map(([href,label,description])=><a href={href} aria-current={active(href)?'page':undefined}><strong>{label}</strong><small>{description}</small></a>)}</div></details>
            </section>
          </div>
          <div class="navigation-account-row"><a id="menu-account-link" href="/account"><UiIcon name="user" size={17}/><span>Your projects</span></a><a href="/saved"><UiIcon name="bookmark" size={17}/><span>Saved items</span></a><button type="button" data-open-search><UiIcon name="search" size={17}/><span>Search Digivated</span><kbd>/</kbd></button></div>
          <div class="navigation-bottom-row"><div><a href="/about">About</a><a href="/access">Packet access</a></div><a id="menu-login-link" href="/login">Log in or sign up <UiIcon size={15}/></a></div>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>import '../scripts/account-header.js';</script>
