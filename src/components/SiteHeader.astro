---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/', 'Home'], ['/discover', 'Projects'], ['/resources', 'Resources'], ['/ui-ux-prompt-packet', 'Prompt Packet'], ['/saved', 'Saved'], ['/about', 'About']];
const active = (href: string) => (href === '/discover' && (path.startsWith('/projects/') || path === '/launch-template')) || path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="platform-header fixed inset-x-0 top-0 z-50 border-b border-brand-line bg-brand-bg">
  <div class="header-inner mx-auto flex items-center justify-between gap-6 px-6">
    <a class="platform-brand shrink-0" href="/" aria-label="Digivated home"><span class="logo-crop"><img src="/digivated-logo-transparent.png" width="32" height="32" alt=""/></span><span>DIGIVATED</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
    <div class="header-actions"><a class="header-sign-in" href="/access">Packet Access</a><a class="button primary header-submit" href="/submit-project">Submit Project <span aria-hidden="true">↗</span></a></div>
    <details class="mobile-menu"><summary aria-controls="platform-mobile-navigation"><span>Menu</span><span class="menu-glyph" aria-hidden="true"></span></summary><nav id="platform-mobile-navigation" aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}<a href="/access">Packet Access</a><a href="/submit-project">Submit Project</a></nav></details>
  </div>
</header>
