---
const { kind, title, summary } = Astro.props;
const visualId = `visual-${kind}`;
---
<figure class={`resource-visual resource-visual--${kind}`}>
  <figcaption class="resource-visual__caption">
    <span class="resource-visual__eyebrow"><span aria-hidden="true">✳</span> FIELD GUIDE / {kind.replaceAll('-', ' ')}</span>
    <h2>{title}</h2>
    <p>{summary}</p>
  </figcaption>
  <svg class="resource-visual__art" viewBox="0 0 460 270" role="img" aria-labelledby={`${visualId}-title ${visualId}-description`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${visualId}-title`}>{title}</title>
    <desc id={`${visualId}-description`}>{summary}</desc>
    <defs>
      <linearGradient id={`${visualId}-glow`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#8de5c7" stop-opacity=".22"/><stop offset="1" stop-color="#8de5c7" stop-opacity="0"/></linearGradient>
      <filter id={`${visualId}-shadow`} x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#000" flood-opacity=".35"/></filter>
    </defs>
    <path class="visual-grid" d="M0 68H460M0 136H460M0 204H460M92 0V270M184 0V270M276 0V270M368 0V270"/>
    <text class="visual-brand" x="22" y="30">DIGIVATED / STAY CURIOUS</text>
    <text class="visual-status" x="438" y="30" text-anchor="end">PRACTICAL NOTES</text>
    {kind === 'agent-boundaries' && <g filter={`url(#${visualId}-shadow)`}>
      <path class="visual-route" d="M84 111H374"/><path class="visual-route-dash" d="M84 111H374"/>
      <g class="visual-node" transform="translate(24 69)"><rect width="112" height="84" rx="13"/><circle cx="56" cy="22" r="11"/><path d="M51 22h10M56 17v10"/><text x="56" y="55" text-anchor="middle">ONE CLEAR</text><text x="56" y="70" text-anchor="middle">TASK</text></g>
      <g class="visual-node visual-node--mint" transform="translate(174 69)"><rect width="112" height="84" rx="13"/><circle cx="56" cy="22" r="11"/><path d="M51 22l4 4 7-8"/><text x="56" y="55" text-anchor="middle">LIMITED</text><text x="56" y="70" text-anchor="middle">ACCESS</text></g>
      <g class="visual-node" transform="translate(324 69)"><rect width="112" height="84" rx="13"/><circle cx="56" cy="22" r="11"/><path d="M50 22h12M56 16v12"/><text x="56" y="55" text-anchor="middle">HUMAN</text><text x="56" y="70" text-anchor="middle">CHECKPOINT</text></g>
      <rect class="visual-chip visual-chip--mint" x="25" y="183" width="177" height="42" rx="10"/><text class="visual-chip-label" x="43" y="209">READ OR DRAFT</text><text class="visual-chip-state" x="185" y="209" text-anchor="end">IN SCOPE</text>
      <rect class="visual-chip" x="214" y="183" width="222" height="42" rx="10"/><text class="visual-chip-label" x="232" y="209">PUBLISH OR DELETE</text><text class="visual-chip-state visual-chip-state--mint" x="419" y="209" text-anchor="end">ASK FIRST</text>
    </g>}
    {kind === 'answer-check' && <g filter={`url(#${visualId}-shadow)`}>
      <path class="visual-route" d="M125 106H335M125 183H335"/>
      <g class="visual-node" transform="translate(24 70)"><rect width="188" height="67" rx="12"/><circle cx="28" cy="33" r="11"/><path d="M24 33h8M28 29v8"/><text x="50" y="30">START WITH THE</text><text x="50" y="48">ANSWER</text></g>
      <g class="visual-node visual-node--mint" transform="translate(248 70)"><rect width="188" height="67" rx="12"/><circle cx="28" cy="33" r="11"/><path d="M23 33l4 4 7-8"/><text x="50" y="30">OPEN THE</text><text x="50" y="48">ORIGINAL SOURCE</text></g>
      <g class="visual-node" transform="translate(24 157)"><rect width="188" height="67" rx="12"/><circle cx="28" cy="33" r="11"/><path d="M24 33h8M28 29v8"/><text x="50" y="30">CHECK THE KEY</text><text x="50" y="48">DETAILS</text></g>
      <g class="visual-node visual-node--mint" transform="translate(248 157)"><rect width="188" height="67" rx="12"/><circle cx="28" cy="33" r="11"/><path d="M23 33l4 4 7-8"/><text x="50" y="30">USE IT OR</text><text x="50" y="48">LEAVE IT OUT</text></g>
    </g>}
    {kind === 'launch-check' && <g filter={`url(#${visualId}-shadow)`}>
      <rect class="visual-panel" x="24" y="61" width="412" height="165" rx="14"/>
      <path class="visual-separator" d="M24 116H436M24 171H436"/>
      <circle class="visual-dot" cx="51" cy="88" r="7"/><text class="visual-label" x="70" y="93">WHAT IS AVAILABLE</text><text class="visual-small" x="414" y="93" text-anchor="end">CONFIRM</text>
      <circle class="visual-dot visual-dot--soft" cx="51" cy="143" r="7"/><text class="visual-label" x="70" y="148">WHAT IS PROMISED</text><text class="visual-small" x="414" y="148" text-anchor="end">SEPARATE</text>
      <circle class="visual-dot" cx="51" cy="198" r="7"/><text class="visual-label" x="70" y="203">WHAT HELPS YOU</text><text class="visual-small" x="414" y="203" text-anchor="end">TRY IT</text>
    </g>}
    {kind === 'design-flow' && <g filter={`url(#${visualId}-shadow)`}>
      <path class="visual-route" d="M79 121H381"/><path class="visual-route-dash" d="M79 121H381"/>
      <g class="visual-node" transform="translate(22 83)"><rect width="100" height="78" rx="12"/><circle cx="50" cy="21" r="9"/><path d="M46 21h8M50 17v8"/><text x="50" y="51" text-anchor="middle">PICK A</text><text x="50" y="66" text-anchor="middle">TASK</text></g>
      <g class="visual-node" transform="translate(132 83)"><rect width="100" height="78" rx="12"/><circle cx="50" cy="21" r="9"/><path d="M46 18h8v6h-8z"/><text x="50" y="51" text-anchor="middle">SKETCH THE</text><text x="50" y="66" text-anchor="middle">FLOW</text></g>
      <g class="visual-node visual-node--mint" transform="translate(242 83)"><rect width="100" height="78" rx="12"/><circle cx="50" cy="21" r="9"/><path d="M45 21l4 4 7-8"/><text x="50" y="51" text-anchor="middle">WATCH A</text><text x="50" y="66" text-anchor="middle">PERSON</text></g>
      <g class="visual-node" transform="translate(352 83)"><rect width="86" height="78" rx="12"/><circle cx="43" cy="21" r="9"/><path d="M39 21h8M43 17v8"/><text x="43" y="51" text-anchor="middle">MAKE</text><text x="43" y="66" text-anchor="middle">IT CLEAR</text></g>
      <text class="visual-takeaway" x="230" y="204" text-anchor="middle">SMALLER STEPS. BETTER FEEDBACK.</text>
    </g>}
    {kind === 'carousel-story' && <g filter={`url(#${visualId}-shadow)`}>
      <path class="visual-route" d="M110 139H351"/><path class="visual-route-dash" d="M110 139H351"/>
      <g class="visual-card" transform="translate(20 72)"><rect width="96" height="133" rx="12"/><path d="M15 18h24"/><text x="15" y="56">THE</text><text x="15" y="74">HOOK</text><text class="visual-small" x="15" y="108">EARN THE</text><text class="visual-small" x="15" y="123">NEXT SWIPE</text></g>
      <g class="visual-card visual-card--mint" transform="translate(130 72)"><rect width="96" height="133" rx="12"/><path d="M15 18h24"/><text x="15" y="56">WHAT</text><text x="15" y="74">HAPPENED</text><text class="visual-small" x="15" y="108">SHOW THE</text><text class="visual-small" x="15" y="123">DETAIL</text></g>
      <g class="visual-card" transform="translate(240 72)"><rect width="96" height="133" rx="12"/><path d="M15 18h24"/><text x="15" y="56">WHY IT</text><text x="15" y="74">MATTERS</text><text class="visual-small" x="15" y="108">ADD THE</text><text class="visual-small" x="15" y="123">CONTEXT</text></g>
      <g class="visual-card" transform="translate(350 72)"><rect width="88" height="133" rx="12"/><path d="M15 18h24"/><text x="15" y="56">THE</text><text x="15" y="74">TAKEAWAY</text><text class="visual-small" x="15" y="108">LEAVE ONE</text><text class="visual-small" x="15" y="123">CLEAR IDEA</text></g>
    </g>}
    {kind === 'account-reset' && <g filter={`url(#${visualId}-shadow)`}>
      <circle class="visual-orbit" cx="230" cy="145" r="73"/><circle class="visual-orbit visual-orbit--inner" cx="230" cy="145" r="43"/>
      <g class="visual-node" transform="translate(20 91)"><rect width="115" height="94" rx="14"/><circle cx="57" cy="23" r="11"/><path d="M52 23h10M57 18v10"/><text x="57" y="61" text-anchor="middle">UPDATE</text><text class="visual-small" x="57" y="77" text-anchor="middle">YOUR APPS</text></g>
      <g class="visual-node visual-node--mint" transform="translate(173 62)"><rect width="115" height="94" rx="14"/><circle cx="57" cy="23" r="11"/><path d="M52 23l4 4 7-8"/><text x="57" y="61" text-anchor="middle">ADD A</text><text class="visual-small" x="57" y="77" text-anchor="middle">SIGN-IN LAYER</text></g>
      <g class="visual-node" transform="translate(325 91)"><rect width="115" height="94" rx="14"/><circle cx="57" cy="23" r="11"/><path d="M52 23h10M57 18v10"/><text x="57" y="61" text-anchor="middle">CHECK</text><text class="visual-small" x="57" y="77" text-anchor="middle">RECOVERY</text></g>
      <text class="visual-takeaway" x="230" y="222" text-anchor="middle">ONE SMALL RESET AT A TIME</text>
    </g>}
    {kind === 'product-promise' && <g filter={`url(#${visualId}-shadow)`}>
      <path class="visual-route" d="M74 128H386"/><path class="visual-route-dash" d="M74 128H386"/>
      <g class="visual-node" transform="translate(22 82)"><rect width="100" height="92" rx="13"/><circle cx="50" cy="24" r="10"/><path d="M46 24h8M50 20v8"/><text x="50" y="60" text-anchor="middle">WHO IT</text><text x="50" y="76" text-anchor="middle">HELPS</text></g>
      <g class="visual-node visual-node--mint" transform="translate(132 82)"><rect width="100" height="92" rx="13"/><circle cx="50" cy="24" r="10"/><path d="M46 24l4 4 7-8"/><text x="50" y="60" text-anchor="middle">WHAT IT</text><text x="50" y="76" text-anchor="middle">CHANGES</text></g>
      <g class="visual-node" transform="translate(242 82)"><rect width="100" height="92" rx="13"/><circle cx="50" cy="24" r="10"/><path d="M46 24h8M50 20v8"/><text x="50" y="60" text-anchor="middle">SHOW A</text><text x="50" y="76" text-anchor="middle">REAL EXAMPLE</text></g>
      <g class="visual-node" transform="translate(352 82)"><rect width="86" height="92" rx="13"/><circle cx="43" cy="24" r="10"/><path d="M39 24h8M43 20v8"/><text x="43" y="60" text-anchor="middle">MAKE THE</text><text x="43" y="76" text-anchor="middle">NEXT STEP</text></g>
    </g>}
  </svg>
</figure>
