---
import ResourceVisual from './ResourceVisual.astro';
const { block } = Astro.props;
const amounts = [0, 0.25, 1].map(fee => ({ fee, value: Math.round(10000 * (1 + .05 - fee / 100) ** 20) }));
const money = value => new Intl.NumberFormat('en-US', {style:'currency', currency:'USD', maximumFractionDigits:0}).format(value);
---
{block.type === 'heading' ? <h2>{block.text}</h2> :
block.type === 'visual' ? <ResourceVisual kind={block.kind} title={block.title} summary={block.summary}/> :
block.type === 'links' ? <section class="resource-linkbook" aria-label={block.title}><h2>{block.title}</h2><ul>{block.items.map(item => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.label} <span aria-hidden="true">↗</span></a><p>{item.description}</p></li>)}</ul><p class="resource-note">Official sources · Opens in a new tab · Check the provider for current requirements and costs.</p></section> :
block.type === 'steps' ? <section class="resource-steps"><h2>{block.title}</h2><ol>{block.items.map(item => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></section> :
block.type === 'carousel' ? <section class="resource-carousel" aria-label={block.title} data-resource-carousel><h2>{block.title}</h2><p class="resource-note">Swipe, scroll, or use the arrows to follow the plan.</p><ol class="resource-slides" tabindex="0" aria-label="Game development plan cards">{block.slides.map((slide,index)=><li><span class="resource-note">{index+1} / {block.slides.length}</span><h3>{slide.title}</h3><p>{slide.text}</p></li>)}</ol><div class="resource-slide-controls" hidden><button type="button" data-slide-previous aria-label="Previous plan card">← Previous</button><span role="status" data-slide-status>Card 1 of {block.slides.length}</span><button type="button" data-slide-next aria-label="Next plan card">Next →</button></div></section> :
block.type === 'fee-chart' ? <figure class="resource-fee-chart"><figcaption><h2>{block.title}</h2><p>Illustrative value after 20 years, starting with $10,000.</p></figcaption><div class="fee-bars" aria-hidden="true">{amounts.map(row=><div><span>{row.fee}% annual fee</span><div class="fee-track"><div class="fee-bar" style={`width:${row.value/amounts[0].value*100}%`}>{money(row.value)}</div></div></div>)}</div><table><caption class="sr-only">Hypothetical investment values by annual fee</caption><thead><tr><th scope="col">Annual fee</th><th scope="col">Value after 20 years</th></tr></thead><tbody>{amounts.map(row=><tr><th scope="row">{row.fee}%</th><td>{money(row.value)}</td></tr>)}</tbody></table><p class="resource-note">5% assumed annual return before fees. No contributions, taxes, or inflation. Simplified annual calculation; not a forecast.</p></figure> : <p>{block.text}</p>}
<script>
for (const carousel of document.querySelectorAll('[data-resource-carousel]')) {
 const track = carousel.querySelector('.resource-slides');
 const previous = carousel.querySelector('[data-slide-previous]');
 const next = carousel.querySelector('[data-slide-next]');
 const status = carousel.querySelector('[data-slide-status]');
 const slides = [...track.children];
 const position = () => slides.reduce((best, slide, index) => Math.abs(slide.offsetLeft - slides[0].offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - slides[0].offsetLeft - track.scrollLeft) ? index : best, 0);
 const update = () => { const index = position(); previous.disabled = index === 0; next.disabled = index === slides.length - 1; status.textContent = `Card ${index+1} of ${slides.length}`; };
 const move = direction => { const index = Math.max(0, Math.min(slides.length - 1, position() + direction)); track.scrollTo({left:slides[index].offsetLeft-slides[0].offsetLeft, behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}); };
 previous.addEventListener('click', () => move(-1)); next.addEventListener('click', () => move(1));
 track.addEventListener('keydown', event => { if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); } });
 track.addEventListener('scroll', update, {passive:true}); new ResizeObserver(update).observe(track);
 carousel.querySelector('.resource-slide-controls').hidden = false; update();
}
</script>
