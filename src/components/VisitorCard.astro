<section class="visitor-card" aria-labelledby="visitors-title" data-visitor-card>
  <h2 id="visitors-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 17 6-6 4 4 8-10M15 5h6v6"/></svg>Monthly visitors</h2>
  <p class="visitor-count" data-visitor-count>—</p>
  <p class="visitor-period">Last 30 complete days</p>
  <div class="visitor-chart"><svg data-visitor-chart viewBox="0 0 600 100" preserveAspectRatio="none" role="img" aria-label="Daily visitor trend" hidden><polyline fill="none" stroke="#7e8745" stroke-width="3" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round"/></svg></div>
  <p class="visitor-source" role="status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-visitor-check hidden><path d="m5 12 4 4L19 6"/></svg><span data-visitor-status>Loading visitor data…</span></p>
</section>
<script>
  const card = document.querySelector('[data-visitor-card]');
  if (card) {
    const status = card.querySelector('[data-visitor-status]');
    fetch('/api/visitors', { signal: AbortSignal.timeout(10000) }).then(async response => {
      if (!response.ok) throw new Error('Visitor data unavailable');
      const data = await response.json();
      if (data.status !== 'ready') { status.textContent = data.status === 'unconfigured' ? 'Visitor analytics coming soon' : 'Visitor data temporarily unavailable'; return; }
      if (!Number.isSafeInteger(data.visitors) || data.visitors < 0 || !Array.isArray(data.daily) || data.daily.length !== 30 || data.daily.some(point => !Number.isFinite(point.visitors) || point.visitors < 0)) throw new Error('Invalid visitor data');
      card.querySelector('[data-visitor-count]').textContent = new Intl.NumberFormat('en-US').format(data.visitors);
      const chart = card.querySelector('[data-visitor-chart]');
      const max = Math.max(1, ...data.daily.map(point => point.visitors));
      chart.querySelector('polyline').setAttribute('points', data.daily.map((point, index) => `${4 + index * 592 / 29},${92 - point.visitors / max * 80}`).join(' '));
      chart.removeAttribute('hidden');
      card.querySelector('[data-visitor-check]').removeAttribute('hidden');
      status.textContent = 'Measured by Google Analytics';
      status.title = `Unique visitors · ${data.startDate} to ${data.endDate} · Updated ${new Date(data.updatedAt).toLocaleString()}`;
    }).catch(() => { status.textContent = 'Visitor data temporarily unavailable'; });
  }
</script>
<style>
.visitor-card{width:100%;max-width:680px;margin:18px auto 64px;padding:32px 34px 26px;border:1px solid #e5e5e7;border-radius:24px;background:#fff}
.visitor-card h2{display:flex;align-items:center;gap:12px;margin:0 0 20px;color:#696a6f;font-size:.875rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
.visitor-card h2 svg{width:22px;height:22px;flex:none;color:#111216}
.visitor-count{margin:0;color:#101114;font-size:clamp(2.8rem,6vw,4rem);font-weight:700;line-height:1.05;letter-spacing:-.06em;font-variant-numeric:tabular-nums}
.visitor-period{margin:10px 0 20px;color:#707177;font-size:1rem}
.visitor-chart{height:100px;margin-bottom:20px}.visitor-chart svg{width:100%;height:100%;overflow:visible}.visitor-chart svg[hidden],.visitor-source svg[hidden]{display:none}
.visitor-source{display:flex;align-items:center;gap:10px;margin:0;padding-top:20px;border-top:1px solid #eeeef0;color:#707177;font-size:.9375rem;line-height:1.5}.visitor-source svg{width:19px;height:19px;flex:none}
@media(max-width:600px){.visitor-card{margin:12px auto 44px;padding:26px 24px 22px;border-radius:20px}.visitor-chart{height:82px}.visitor-card h2{font-size:.8125rem;letter-spacing:.1em}}
</style>
