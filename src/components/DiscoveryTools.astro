---
import resources from '../data/resources.json';
import { resourcePathInfo } from '../data/learning-paths.mjs';
const index = resources.filter(r => r.status === 'published').map(r => ({type:'resource',title:r.title,description:r.description,category:r.category,keywords:resourcePathInfo(r).path?.keywords || '',href:`/resources/${r.slug}`}));
index.unshift({type:'resource',title:'UI/UX Prompt Packet',description:'75 practical prompts, workflows, and checklists.',category:'Design & UX',href:'/ui-ux-prompt-packet'});
---
<script type="application/json" id="discovery-index" set:html={JSON.stringify(index).replace(/</g,'\u003c')}/>
<dialog class="discovery-dialog search-dialog" id="discovery-search" aria-labelledby="discovery-search-title">
  <div class="discovery-dialog-head"><div><p class="discovery-eyebrow">EXPLORE DIGIVATED</p><h2 id="discovery-search-title">Find your next good idea.</h2></div><button type="button" class="discovery-close" data-close-search aria-label="Close search">×</button></div>
  <label class="unified-search-label"><span class="sr-only">Search Digivated</span><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="unified-search-input" type="search" placeholder="Projects, guides, and tools…" autocomplete="off"/></label>
  <div class="search-scopes" role="group" aria-label="Search content type"><button type="button" data-search-type="all" aria-pressed="true">All</button><button type="button" data-search-type="project" aria-pressed="false">Projects</button><button type="button" data-search-type="resource" aria-pressed="false">Resources</button></div>
  <p class="search-count" id="unified-search-status" role="status"></p>
  <nav class="unified-results" id="unified-results" aria-label="Search results"></nav>
  <div class="search-empty" id="unified-search-empty" hidden><h3>A new direction?</h3><p>Try a project name or a broader topic such as AI, design, or markets.</p><a href="/discover">Explore all projects ↗</a></div>
  <p class="search-footnote">A little curiosity goes a long way. <span><kbd>Esc</kbd> to close</span></p>
</dialog>
<dialog class="discovery-dialog preview-dialog" id="project-preview" aria-labelledby="project-preview-title">
  <div class="discovery-dialog-head"><p class="discovery-eyebrow">PROJECT PREVIEW</p><button type="button" class="discovery-close" data-close-preview aria-label="Close project preview">×</button></div>
  <div class="preview-stage" aria-hidden="true"><div class="preview-orbit"></div><div class="preview-identity" id="preview-identity"></div></div>
  <div class="preview-copy"><p class="preview-category" id="preview-category"></p><h2 id="project-preview-title"></h2><p class="preview-creator" id="preview-creator"></p><p class="preview-description" id="preview-description"></p><p class="preview-meta" id="preview-meta"></p><a class="button primary preview-visit" id="preview-visit" target="_blank" rel="noopener noreferrer">Visit project <span aria-hidden="true">↗</span></a></div>
  <div class="preview-navigation"><button type="button" id="preview-previous">← Previous</button><span id="preview-position" role="status"></span><button type="button" id="preview-next">Next →</button></div>
</dialog>
<script>import '../scripts/discovery.js';</script>
