---
import { cardIconMarkup } from '../lib/card-icons.mjs';
import Platform from '../layouts/Platform.astro';
import '../styles/community.css';
const {view='feed'}=Astro.props;
const labels={feed:'Community',chat:'Global chat',profile:'Member profile',settings:'Edit profile',moderate:'Community moderation'};
---
<Platform title={labels[view]} description="Meet curious people. Share what you are learning and what you are making.">
<section class="community-app" data-community-view={view}>
 <header class="community-heading"><div><p class="eyebrow">A place for curious people</p><h1>Good ideas start<br/>with <em>each other.</em></h1></div><button class="button primary" data-member-login>Join the community <span aria-hidden="true">↗</span></button><button class="button" data-member-logout hidden>Sign out</button></header>
 <div class="community-layout">
 <aside class="community-sidebar"><nav aria-label="Community"><a href="/community" aria-current={view==='feed'?'page':undefined}><Fragment set:html={cardIconMarkup('layers')}/> <span>Feed</span></a><a href="/community/chat" aria-current={view==='chat'?'page':undefined}><Fragment set:html={cardIconMarkup('comment')}/> <span>Global chat</span></a><a href="/community/profile" aria-current={view==='profile'?'page':undefined}><Fragment set:html={cardIconMarkup('profile')}/> <span>My profile</span></a><a href="/community/settings" aria-current={view==='settings'?'page':undefined}><Fragment set:html={cardIconMarkup('tool')}/> <span>Settings</span></a></nav><div class="community-note"><span class="x-brand-mark" aria-hidden="true"></span><h2>Make yourself at home.</h2><p>Share something useful. Ask a question. Help someone take their next step.</p><a href="/community?welcome=1">Meet Digivated ↗</a></div></aside>
 <div class="community-main"><p id="community-status" role="status" aria-live="polite">Opening the community…</p>
 {view==='feed'&&<><div class="community-tabs" aria-label="Feed filters"><button data-feed="latest" aria-pressed="true">Latest</button><button data-feed="following" aria-pressed="false">Following</button><button data-feed="saved" aria-pressed="false">Saved</button></div><form id="community-composer" class="community-surface"><label for="post-body">What have you been exploring?</label><textarea id="post-body" name="body" rows="3" maxlength="2000" placeholder="An idea, a discovery, or something you are making" required></textarea><div class="composer-options"><label>Post type<select name="kind"><option value="post">Conversation</option><option value="project">My project</option></select></label><label>Project link<input name="project_url" type="url" placeholder="https://"/></label></div><div class="composer-footer"><label class="community-upload">＋ Add image<input name="image" type="file" accept="image/png,image/jpeg,image/webp"/><span class="upload-name"></span></label><button class="button primary" type="submit">Post ↗</button></div><p class="community-caption">Your post and images will be public. Keep it kind and useful.</p></form><div id="community-feed"></div><button id="community-more" class="button" hidden>Load more</button></>}
 {view==='chat'&&<section class="community-surface chat-surface"><header><div><h2>The global room</h2><p>Drop in and join the conversation.</p></div><span class="community-badge">Community chat</span></header><div id="community-chat" class="community-chat" aria-label="Chat messages"></div><form id="chat-form"><label class="sr-only" for="chat-body">Message</label><input id="chat-body" name="body" maxlength="600" placeholder="Say something…" required/><button class="button primary">Send ↗</button></form><p class="community-caption">Messages are public. Use the report or mute controls when needed.</p></section>}
 {view==='profile'&&<><section id="community-profile"></section><div id="community-feed"></div><button id="community-more" class="button" hidden>Load more</button></>}
 {view==='settings'&&<form id="profile-form" class="community-surface profile-form"><h2>Your corner of Digivated</h2><p>Let people get to know the person behind your ideas.</p><label class="community-upload">Profile picture<input name="avatar" type="file" accept="image/png,image/jpeg,image/webp"/><span class="upload-name"></span></label><label>Display name<input name="name" maxlength="60" autocomplete="name" required/></label><label>Handle<input name="handle" pattern="[a-z0-9_]{3,24}" minlength="3" maxlength="24" placeholder="your_name" required/><small>3 to 24 lowercase letters, numbers, or underscores</small></label><label>Bio<textarea name="bio" maxlength="240" rows="3" placeholder="What are you curious about?"/></label><label>Website<input name="website" type="url" placeholder="https://your-site.com"/></label><fieldset><legend>Your interests</legend>{['Technology','AI','Markets','Tools','Building'].map(t=><label class="interest-option"><input type="checkbox" name="interests" value={t}/>{t}</label>)}</fieldset><button class="button primary">Save profile</button><h3>Muted members</h3><div id="community-muted"></div></form>}
 {view==='moderate'&&<section class="community-surface"><h2>Community reports</h2><p>Use your existing <a href="/admin">owner sign-in</a> to review reports and manage posting access.</p><div id="moderation-list"></div><form id="moderation-restore"><label>Post or member ID<input name="id" required/></label><button class="button" name="operation" value="restore">Restore post</button><button class="button" name="operation" value="unsuspend">Restore member access</button></form></section>}
 </div><aside class="community-right"><div class="community-surface"><p class="eyebrow">Around Digivated</p><h2>Keep your curiosity going.</h2><a href="/resources">Explore the resources <span>↗</span></a><a href="/discover">Meet Digivated Picks <span>↗</span></a><a href="/submit-project">Submit your project <span>↗</span></a></div><p class="community-caption">Be helpful. Credit your sources. Respect the people behind the screen.</p></aside>
 </div>
</section>
<dialog id="community-auth" class="community-dialog"><button class="dialog-close" data-close aria-label="Close sign in">×</button><span class="x-brand-mark" aria-hidden="true"></span><h2>A little curiosity.<br/>A lot of connection.</h2><p>Join Digivated to share ideas and meet the people making things happen.</p><button id="community-google" class="button primary" hidden>Continue with Google</button><form id="community-email"><label>Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label><button class="button primary">Email me a sign-in link</button></form><p id="community-auth-status" role="status"></p><button data-close class="button">Continue browsing</button></dialog>
<dialog id="community-welcome" class="community-dialog community-welcome"><button data-close class="welcome-skip">Skip intro ↗</button><span class="x-brand-mark" aria-hidden="true"></span><div class="welcome-art"><img src="/digivated-mark.svg" alt=""/></div><p class="eyebrow" id="welcome-kicker">Explore Digivated</p><h2 id="welcome-title">Follow your<br/>curiosity.</h2><p id="welcome-copy">Find useful ideas in technology, AI, markets, and the tools that move you forward.</p><div class="welcome-progress" aria-hidden="true"><i class="active"></i><i></i><i></i></div><button id="welcome-next" class="button primary">Continue ↗</button><button data-close class="welcome-browse">Continue browsing</button></dialog>
<dialog id="community-replies" class="community-dialog"><button class="dialog-close" data-close aria-label="Close replies">×</button><h2>Join the conversation</h2><div id="reply-list"></div><form id="reply-form"><label>Your reply<textarea name="body" maxlength="2000" required rows="3"/></label><button class="button primary">Reply ↗</button></form><p id="reply-status" role="status"></p></dialog>
<script>import '../scripts/member-community.js';</script>
</Platform>
