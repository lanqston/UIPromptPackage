---
import { cardIconMarkup } from '../lib/card-icons.mjs';
import Platform from '../layouts/Platform.astro';
import '../styles/community.css';
import '../styles/community-dark.css';
const {view='feed'}=Astro.props;
const labels={feed:'Community',chat:'Global chat',profile:'Member profile',settings:'Edit profile',members:'Find your people',moderate:'Community moderation',alerts:'Your activity'};
---
<Platform title={labels[view]} description="Meet curious people. Share what you are learning and what you are making.">
<section class="community-app" data-community-view={view}>
 <header class="community-topbar"><a class="community-wordmark" href="/community" aria-label="Community home"><img src="/digivated-mark.svg" alt=""/><span>Digivated<small>COMMUNITY</small></span></a><div class="community-utilities"><a href="/community/members" aria-label="Search members"><Fragment set:html={cardIconMarkup('eye')}/></a><a href="/community/chat" aria-label="Global chat"><Fragment set:html={cardIconMarkup('comment')}/></a><a href="/community/settings" aria-label="Profile settings"><Fragment set:html={cardIconMarkup('tool')}/></a></div></header>
 <header class="community-heading"><div><p class="eyebrow">YOUR PEOPLE. YOUR IDEAS.</p><h1>{view==='feed'?"Stay curious.":labels[view]}</h1></div><div class="community-account-actions"><button class="button" data-member-login data-auth-open="login">Log in</button><button class="button primary" data-member-login data-auth-open="signup">Join</button><button class="button" data-member-logout hidden>Sign out</button></div></header>
 <div class="community-layout">
 <aside class="community-sidebar"><nav aria-label="Community"><a href="/community" aria-current={view==='feed'?'page':undefined}><Fragment set:html={cardIconMarkup('layers')}/> <span>Feed</span></a><a href="/community/chat" aria-current={view==='chat'?'page':undefined}><Fragment set:html={cardIconMarkup('comment')}/> <span>Global chat</span></a><a href="/community/members" aria-current={view==='members'?'page':undefined}><Fragment set:html={cardIconMarkup('profile')}/> <span>Members</span></a><a href="/community/profile" aria-current={view==='profile'?'page':undefined}><Fragment set:html={cardIconMarkup('profile')}/> <span>My profile</span></a><a href="/community/alerts" aria-current={view==='alerts'?'page':undefined}><Fragment set:html={cardIconMarkup('sparkle')}/> <span>Alerts</span></a><a href="/community/settings" aria-current={view==='settings'?'page':undefined}><Fragment set:html={cardIconMarkup('tool')}/> <span>Settings</span></a></nav><div class="community-note"><span class="x-brand-mark" aria-hidden="true"></span><h2>Make yourself at home.</h2><p>Share something useful. Ask a question. Help someone take their next step.</p><a href="/community?welcome=1">Meet Digivated ↗</a></div></aside>
 <div class="community-main"><div id="member-setup" class="setup-nudge" hidden><span>Make this space yours. Add your name and interests.</span><a href="/community/settings">Create your profile ↗</a></div><p id="community-status" role="status" aria-live="polite">Opening the community…</p>
 {view==='feed'&&<><div class="community-topics"><div><h2>Find your next conversation</h2><span>Explore a topic</span></div><div class="community-topic-row">{[['','All'],['Tech','Tech'],['AI','AI'],['Markets','Markets'],['Sports','Sports'],['NCAAF','NCAAF'],['Tennis','Tennis']].map(([term,label])=><button type="button" data-topic={term} aria-pressed={term===''}><span>{label==='All'?'✦':label.slice(0,2)}</span>{label}</button>)}</div><form id="community-search" role="search"><label class="sr-only" for="feed-query">Search community posts</label><input id="feed-query" name="query" type="search" maxlength="100" placeholder="Search ideas and conversations…"/><button class="button" type="submit">Search</button></form></div><div class="community-tabs" aria-label="Feed filters"><button data-feed="latest" aria-pressed="true">Latest</button><button data-feed="following" aria-pressed="false">Following</button><button data-feed="saved" aria-pressed="false">Saved</button></div><form id="community-composer" class="community-surface"><div class="composer-identity"><span id="composer-avatar" class="member-avatar">✦</span><span>YOUR NEXT CONVERSATION</span></div><label for="post-body">What have you been exploring?</label><textarea id="post-body" name="body" rows="3" maxlength="2000" placeholder="An idea, a discovery, or something you are making" required></textarea><div class="composer-options"><label>Post type<select name="kind"><option value="post">Conversation</option><option value="project">My project</option></select></label><label id="community-project-link" hidden>Project link<input name="project_url" type="url" placeholder="https://"/></label></div><div id="composer-preview" class="image-preview" hidden><img alt="Selected post image"/><button type="button" id="remove-post-image" aria-label="Remove image">×</button></div><div class="composer-footer"><label class="community-upload">＋ Add image<input name="image" type="file" accept="image/png,image/jpeg,image/webp"/><span class="upload-name"></span></label><button class="button primary" type="submit">Post ↗</button></div><p class="community-caption"><span id="post-counter">0 / 2,000</span> · Your post and images will be public. Keep it kind and useful.</p></form><div id="community-feed"></div><button id="community-more" class="button" hidden>Load more</button></>}
 {view==='alerts'&&<section class="community-surface"><p class="eyebrow">YOUR CONVERSATIONS</p><h2>Replies to you</h2><p class="community-caption">Recent replies to your latest 100 posts.</p><div id="community-alerts"></div></section>}
 {view==='members' &&<section class="community-surface members-surface"><p class="eyebrow">GOOD COMPANY</p><h2>Find your people.</h2><p>Meet the people exploring, learning, and building here.</p><form id="member-search" class="member-search"><label class="sr-only" for="member-query">Search members</label><input id="member-query" name="query" type="search" maxlength="60" placeholder="Search names or handles…"/><button class="button">Search</button></form><div id="member-results"></div><button type="button" id="members-more" class="button" hidden>More members</button></section>}
 {view==='chat'&&<section class="community-surface chat-surface"><header><div><h2>The global room</h2><p>Drop in and join the conversation.</p></div><span id="chat-connection" class="community-badge">Connecting…</span></header><button id="chat-older" type="button" class="community-action" hidden>Earlier messages ↑</button><div id="community-chat" class="community-chat" aria-label="Chat messages"></div><button id="chat-new" type="button" class="community-action" hidden>New messages ↓</button><p id="chat-presence" class="community-caption" aria-live="polite"></p><form id="chat-form"><label class="sr-only" for="chat-body">Message</label><input id="chat-body" name="body" maxlength="600" placeholder="Say something…" required/><button class="button primary">Send ↗</button></form><p class="community-caption">Messages are public. Use the report or mute controls when needed.</p></section>}
 {view==='profile'&&<><section id="community-profile"></section><div id="community-feed"></div><button id="community-more" class="button" hidden>Load more</button></>}
 {view==='settings'&&<form id="profile-form" class="community-surface profile-form"><p class="eyebrow">PROFILE & PREFERENCES</p><h2>Edit your profile</h2><p>Let people get to know the person behind your ideas.</p><div id="settings-preview" class="settings-preview"><div class="member-cover" data-theme="mint"></div><span class="member-avatar">✦</span><strong id="settings-name">Your name, your space.</strong></div><fieldset class="cover-options"><legend>Cover style</legend>{['mint','sky','sunset','violet','graphite'].map((theme,i)=><label class="cover-choice" data-theme={theme}><input type="radio" name="cover_theme" value={theme} checked={i===0}/><span>{theme}</span></label>)}</fieldset><label class="community-upload">Cover image<input name="cover" type="file" accept="image/png,image/jpeg,image/webp"/><span class="upload-name"></span></label><label class="interest-option"><input name="remove_cover" type="checkbox"/>Use atmosphere instead of my cover image</label><label class="community-upload">Profile picture<input name="avatar" type="file" accept="image/png,image/jpeg,image/webp"/><span class="upload-name"></span></label><label>Display name<input name="name" maxlength="60" autocomplete="name" required/></label><label>Handle<input name="handle" autocapitalize="none" spellcheck="false" minlength="3" maxlength="24" placeholder="your_name" required/><small>3 to 24 lowercase letters, numbers, or underscores</small></label><label>Bio<textarea name="bio" maxlength="240" rows="3" placeholder="What are you curious about?"/></label><label>Website<input name="website" type="text" inputmode="url" placeholder="https://your-site.com"/></label><fieldset><legend>Your interests</legend>{['Technology','AI','Markets','Tools','Building'].map(t=><label class="interest-option"><input type="checkbox" name="interests" value={t}/>{t}</label>)}</fieldset><div class="profile-save-bar"><p id="profile-save-status" role="status" aria-live="polite"></p><button type="submit" class="button primary">Save profile</button></div><div class="settings-section"><h3>Your account</h3><p id="account-email" class="community-caption"></p><p class="community-caption">Your email stays private. Manage your public profile here.</p></div><h3>Muted members</h3><div id="community-muted"></div></form>}
 {view==='moderate'&&<section class="community-surface"><h2>Community reports</h2><p>Use your existing <a href="/admin">owner sign-in</a> to review reports and manage posting access.</p><div id="moderation-list"></div><form id="moderation-restore"><label>Post or member ID<input name="id" required/></label><button class="button" name="operation" value="restore">Restore post</button><button class="button" name="operation" value="unsuspend">Restore member access</button></form></section>}
 </div><aside class="community-right"><div class="community-surface community-discovery"><p class="eyebrow">MAKE A CONNECTION</p><h2>Good company.</h2><div id="member-suggestions"><p class="community-caption">Discover curious minds from around Digivated.</p></div><a href="/community/members">Explore members <span>↗</span></a></div><div class="community-surface"><p class="eyebrow">Around Digivated</p><h2>Keep your curiosity going.</h2><a href="/resources">Explore the resources <span>↗</span></a><a href="/discover">Browse projects <span>↗</span></a><a href="/submit-project">Submit your project <span>↗</span></a></div><p class="community-caption">Be helpful. Credit your sources. Respect the people behind the screen.</p></aside>
 </div>
 <a class="community-fab" href="/community?compose=1" aria-label="Create a post">＋</a>
 <nav class="community-dock" aria-label="Community dock">{[['feed','/community','Home','layers'],['members','/community/members','Explore','eye'],['alerts','/community/alerts','Alerts','sparkle'],['profile','/community/profile','Profile','profile']].map(([key,href,label,icon])=><a href={href} aria-current={view===key?'page':undefined}><Fragment set:html={cardIconMarkup(icon)}/><span>{label}</span></a>)}</nav>
</section>
<dialog id="community-auth" class="community-dialog auth-dialog" aria-labelledby="auth-title">
 <button class="dialog-close" data-close aria-label="Close sign in">×</button><span class="x-brand-mark" aria-hidden="true"></span>
 <p class="eyebrow">YOUR PEOPLE. YOUR IDEAS.</p><h2 id="auth-title">Welcome to Digivated.</h2><p id="auth-description">Create your account and make yourself at home.</p>
 <div class="auth-switch" aria-label="Account access"><button type="button" data-auth-mode="signup" aria-pressed="true">Create account</button><button type="button" data-auth-mode="login" aria-pressed="false">Log in</button></div>
 <button id="community-google" type="button" class="button auth-provider" hidden>Continue with Google</button>
 <form id="community-email">
 <label id="auth-email-label">Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label>
 <label id="auth-password-label">Password<div class="auth-password"><input name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="At least 8 characters" required/><button type="button" id="auth-show-password" aria-label="Show password">Show</button></div></label>
 <button id="auth-submit" class="button primary" type="submit">Create account</button>
 </form>
 <div id="auth-check-email" class="auth-email-sent" hidden><span aria-hidden="true">✉</span><h3>Check your inbox</h3><p id="auth-email-instructions"></p><p class="community-caption">Check spam or junk if you don’t see it. Use the newest email.</p><button type="button" id="auth-resend" class="button">Resend verification email</button><button type="button" id="auth-change-email" class="community-action">Use a different email</button></div>
 <p id="community-auth-status" role="status" aria-live="polite"></p>
 <button type="button" id="auth-email-link" class="community-action" hidden>Email me a sign-in link</button>
 <button type="button" id="auth-forgot" class="community-action" hidden>Forgot password?</button><button type="button" id="auth-back" class="community-action" hidden>Back to log in</button>
 <p class="community-caption" id="auth-privacy">Your email stays private. Your profile is public.</p>
 <button data-close class="button">Continue browsing</button>
</dialog>
<dialog id="community-welcome" class="community-dialog community-welcome"><button data-close class="welcome-skip">Skip intro ↗</button><span class="x-brand-mark" aria-hidden="true"></span><div class="welcome-art"><img src="/digivated-mark.svg" alt=""/></div><p class="eyebrow" id="welcome-kicker">Explore Digivated</p><h2 id="welcome-title">Stay curious about<br/>what’s next.</h2><p id="welcome-copy">Find useful ideas in technology, AI, markets, and the tools that move you forward.</p><div class="welcome-progress" aria-hidden="true"><i class="active"></i><i></i><i></i></div><button id="welcome-next" class="button primary">Explore the community ↗</button><button data-close class="welcome-browse">Continue browsing</button></dialog>
<dialog id="community-replies" class="community-dialog"><button class="dialog-close" data-close aria-label="Close replies">×</button><h2>Join the conversation</h2><div id="reply-parent"></div><div id="reply-list"></div><button id="replies-more" type="button" class="button" hidden>More replies</button><form id="reply-form"><label>Your reply<textarea name="body" maxlength="2000" required rows="3"/></label><button class="button primary">Reply ↗</button></form><p id="reply-status" role="status"></p></dialog>
<dialog id="community-report" class="community-dialog"><button class="dialog-close" data-close aria-label="Close report">×</button><p class="eyebrow">KEEP THIS SPACE KIND</p><h2>Report a post</h2><p>Tell us what needs a closer look. Your report is visible only to you and the owner.</p><form id="report-form"><label>Reason<textarea name="reason" required minlength="3" maxlength="500" rows="4" placeholder="What should we know?"/></label><button class="button primary">Send report</button></form><p id="report-status" role="status"></p></dialog>
<dialog id="community-image" class="community-dialog image-dialog"><button class="dialog-close" data-close aria-label="Close image">×</button><img id="expanded-image" alt="Shared community image"/></dialog>
<dialog id="community-edit" class="community-dialog"><button class="dialog-close" data-close aria-label="Close edit">×</button><h2>Edit your post</h2><form id="edit-post-form"><label>Post<textarea name="body" required maxlength="2000" rows="6"/></label><button class="button primary">Save changes</button></form><p id="edit-status" role="status"></p></dialog>
<script>import '../scripts/member-community.js';</script>
</Platform>
