---
import IconLink from './IconLink.astro';
---
<div class="hero-composition" aria-label="A place to build, share, and learn">
  <div class="hero-notebook">
    <div class="notebook-top"><span class="tiny">Made by Digivated</span><img src="/digivated-logo-site.jpg" width="38" height="38" alt=""/></div>
    <p class="notebook-title">A clearer start.<br/>A better build.</p>
    <div class="notebook-lines"><span>Plan your idea</span><span>Shape the experience</span><span>Make it yours</span></div>
    <a class="button primary" href="/ui-ux-prompt-packet">Explore the Prompt Packet</a>
  </div>
  <div class="hero-invitation"><div><span class="tiny">The community directory</span><p>Make room for<br/>your next idea.</p></div><IconLink href="/submit-project" label="Submit your project to Digivated"/></div>
  <a class="hero-library" href="/resources"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h6v16H4zM14 4l5-1 3 16-5 1z"/></svg><span><strong>The resource library</strong><span>Ideas for your next step</span></span></a>
</div>
