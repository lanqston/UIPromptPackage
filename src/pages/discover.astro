---
import Platform from '../layouts/Platform.astro';
import LiveProjects from '../components/LiveProjects.astro';
import { projectCategories } from '../data/community.mjs';
import '../styles/projects-dashboard.css';
---
<Platform title="Projects" description="An open dashboard for discovering independent projects, tools, and the people building them.">
<div class="projects-workspace">
  <aside class="projects-sidebar" aria-label="Browse projects">
    <p class="dashboard-kicker">Discover</p>
    <nav class="project-collections" aria-label="Project collections">
      <button type="button" data-directory-view="newest" aria-pressed="true">All projects <span data-project-total>—</span></button>
      <button type="button" data-directory-view="picks" aria-pressed="false">Digivated Picks <span data-project-picks>—</span></button>
      <button type="button" data-directory-view="featured" aria-pressed="false">Featured <span data-project-featured>—</span></button>
      <a href="/saved">Saved projects <span aria-hidden="true">↗</span></a>
    </nav>
    <details class="project-categories" open>
      <summary class="dashboard-kicker">Categories</summary>
      <div class="project-category-list" role="group" aria-label="Filter by category">
        <button type="button" data-category-filter="" aria-pressed="true">All categories</button>
        {projectCategories.map(category => <button type="button" data-category-filter={category} aria-pressed="false"><span>{category}</span><span data-category-count={category}></span></button>)}
      </div>
    </details>
    <div class="dashboard-invite"><h2>Building something?</h2><p>Share your project with curious people.</p><a href="/submit-project">Submit for free <span aria-hidden="true">↗</span></a></div>
  </aside>
  <section class="projects-content" aria-labelledby="projects-title">
    <header class="dashboard-intro"><p class="dashboard-kicker">The builder directory</p><h1 id="projects-title">Good work. Out in the open.</h1><p>Find independent projects, meet their creators, and save what catches your eye.</p></header>
    <dl class="dashboard-overview" aria-label="Directory overview"><div><dt>Reviewed projects</dt><dd data-project-total>—</dd></div><div><dt>Categories represented</dt><dd data-project-categories>—</dd></div><div><dt>Digivated Picks</dt><dd data-project-picks>—</dd></div></dl>
    <div class="dashboard-controls" data-directory="projects">
      <label class="project-search"><span class="sr-only">Search projects</span><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><input id="directory-search" type="search" placeholder="Search projects, creators, or ideas"/></label>
      <label class="mobile-category"><span class="sr-only">Category</span><select id="directory-category"><option value="">All categories</option>{projectCategories.map(c=><option>{c}</option>)}</select></label>
      <select id="directory-view" hidden aria-label="Collection"><option value="newest">All projects</option><option value="picks">Digivated Picks</option><option value="featured">Featured</option></select>
      <label class="project-sort"><span class="sr-only">Sort projects</span><select id="directory-sort"><option value="newest">Newest first</option><option value="views">Most viewed</option><option value="name">Name A–Z</option></select></label>
      <div class="project-layout-toggle" role="group" aria-label="Project layout"><button type="button" data-directory-layout="grid" aria-pressed="true" aria-label="Grid view"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg></button><button type="button" data-directory-layout="list" aria-pressed="false" aria-label="List view"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 5h12M8 12h12M8 19h12M3 5h1M3 12h1M3 19h1"/></svg></button></div>
    </div>
    <div class="dashboard-results"><h2 id="directory-heading">All projects</h2><p id="directory-status" class="results-status" role="status">Loading projects…</p><button class="clear-project-filters" type="button" data-directory-clear hidden>Clear filters</button></div>
    <LiveProjects mode="all" directory title="Your next discovery is still to come." description="Reviewed projects will appear here. Share your work for review." href="/submit-project" label="Submit Your Project"/>
    <p class="dashboard-review-note">Every project is reviewed before appearing here. Selected projects may also be featured across Digivated socials.</p>
  </section>
</div>
<script>import '../scripts/directory.js'; import '../scripts/live-content.js';</script>
</Platform>
