---
import Platform from '../layouts/Platform.astro';
import LiveProjects from '../components/LiveProjects.astro';
import { projectCategories } from '../data/community.mjs';
---
<Platform title="Projects"><header class="page-intro"><p class="eyebrow">THE COMMUNITY</p><h1>Meet the ideas behind what’s next.</h1><p class="lede">Explore independent projects from creators and builders. Open a project to take a closer look, or save it to your private collection.</p></header><div class="browse-controls" data-directory="projects"><label>Search projects<input id="directory-search" type="search" placeholder="Project, creator, or idea"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{projectCategories.map(c=><option>{c}</option>)}</select></label><label>Browse<select id="directory-view"><option value="newest">Newest</option><option value="featured">Featured</option><option value="picks">Digivated Picks</option></select></label></div><p class="results-status" id="directory-status" role="status">Loading projects…</p><LiveProjects directory title="Your next discovery is still to come." description="No projects to show yet. Share your work for review, or check back as the directory grows." href="/submit-project" label="Submit Your Project"/><p class="quiet">Every project is reviewed before appearing here. Selected projects may also be featured across Digivated socials.</p><script>import '../scripts/directory.js'; import '../scripts/live-content.js';</script></Platform>

