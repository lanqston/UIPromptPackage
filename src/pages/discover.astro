---
import Platform from '../layouts/Platform.astro';
import LiveProjects from '../components/LiveProjects.astro';
import { projectCategories } from '../data/community.mjs';
---
<Platform title="Projects"><header class="page-intro"><p class="eyebrow">COMMUNITY PROJECTS</p><h1>Good work deserves a closer look.</h1><p class="lede">Independent projects reviewed and approved by Digivated. Meet their creators, explore their work, and save what catches your eye.</p></header><div class="browse-controls" data-directory="projects"><label>Search projects<input id="directory-search" type="search" placeholder="Project, creator, or idea"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{projectCategories.map(c=><option>{c}</option>)}</select></label></div><p class="results-status" id="directory-status" role="status">Loading projects…</p><LiveProjects mode="all" directory title="Your next discovery is still to come." description="Reviewed projects will appear here. Share your work for review." href="/submit-project" label="Submit Your Project"/><p class="quiet">Every project is reviewed before appearing here. Selected projects may also be featured across Digivated socials.</p><script>import '../scripts/directory.js'; import '../scripts/live-content.js';</script></Platform>

