---
import Platform from '../layouts/Platform.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EmptyState from '../components/EmptyState.astro';
import projects from '../data/projects.json';
import { publicProjects, projectCategories } from '../data/community.mjs';
const approved = publicProjects(projects);
---
<Platform title="Discover"><header class="page-intro"><p class="eyebrow">Made by people like you</p><h1>Discover what’s<br/>taking shape.</h1><p class="lede">Explore projects from independent creators and builders. A useful idea could be just around the corner.</p></header><div class="browse-controls" data-directory="projects"><label>Search projects<input id="directory-search" type="search" placeholder="Project, creator, or idea"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{projectCategories.map(c=><option>{c}</option>)}</select></label><label>Browse<select id="directory-view"><option value="newest">Newest</option><option value="featured">Featured</option><option value="picks">Digivated Picks</option></select></label></div><p class="results-status" id="directory-status" role="status">{approved.length} approved projects</p><div class="project-grid">{approved.map(project=><ProjectCard project={project}/>)}</div><div id="directory-empty" hidden={approved.length>0}><EmptyState title="Your next discovery is still to come." description="No projects to show yet. Share your work for review, or check back as the directory grows." href="/submit-project" label="Submit Your Project"/></div><p class="quiet">Every project is reviewed before appearing here. Selected projects may also be featured across Digivated socials.</p><script>import '../scripts/directory.js';</script></Platform>
