---
import Platform from '../layouts/Platform.astro';
---
<Platform title="Saved"><header class="page-intro"><p class="eyebrow">A little inspiration for later</p><h1>Your collections</h1><p class="lede">Projects to explore. Resources to come back to.</p><p>Saved in this browser only. Private on this device, with no login or cross-device sync. Export a backup before clearing browser data.</p></header>
<section id="saved-root"><div class="actions"><button class="button primary" id="new-collection">New collection</button><button class="button" id="export-collections">Export JSON</button><label class="button import-label">Import JSON<input id="import-collections" type="file" accept="application/json,.json"/></label><button class="button" id="refresh-saved">Refresh items</button></div><p id="saved-status" role="status"></p><nav id="saved-folders" aria-label="Your collections" class="actions"></nav><div class="browse-controls"><label>Search saved items<input type="search" id="saved-search"/></label><label>Item type<select id="saved-type"><option value="">All items</option><option value="project">Projects</option><option value="resource">Resources</option></select></label></div><div class="actions"><h2 id="saved-heading" tabindex="-1">Saved items</h2><button class="button" id="rename-collection" hidden>Rename collection</button><button class="button" id="delete-collection" hidden>Delete collection</button></div><p id="saved-empty"></p><div id="saved-items" class="resource-grid"></div></section>
<dialog id="collection-manager" class="collection-dialog" aria-labelledby="collection-manager-title"><h2 id="collection-manager-title">Collection name</h2><form id="collection-manager-form"><label>Name<input id="collection-name" maxlength="60" required/></label><p id="collection-manager-status" role="status"></p><button class="button primary" type="submit">Save collection</button><button class="button" type="button" id="cancel-collection">Cancel</button></form></dialog><noscript>Enable JavaScript to use browser collections.</noscript></Platform>
