---
import Platform from '../layouts/Platform.astro';
import { projectCategories } from '../data/community.mjs';
---
<Platform title="Submit Your Project"><header class="page-intro"><p class="eyebrow">Every project starts with a person</p><h1>What are you building?</h1><p class="lede">Share your project with Digivated for a chance to be discovered, featured, or reposted.</p></header><div class="submission-layout"><form class="submission-form" id="project-form" action="/api/submissions" method="post"><fieldset><legend><span>01</span> About you</legend><div class="form-row"><label>Creator Name<input name="creator" placeholder="Your name" autocomplete="name" maxlength="100" required/></label><label>Email<input name="email" placeholder="you@example.com" type="email" autocomplete="email" maxlength="254" required/><span class="field-help">For review only. Never displayed publicly.</span></label></div></fieldset><fieldset><legend><span>02</span> Your project</legend><label>Project Name<input name="name" placeholder="What’s your project called?" maxlength="120" required/></label><label>Project URL<input name="url" type="url" placeholder="https://your-project.com" maxlength="500" required/></label><label>Project Description<textarea name="description" rows="4" minlength="20" maxlength="600" required placeholder="What does it do, and who is it for?"></textarea><span class="field-help">20–600 characters. Keep it clear and useful.</span></label><label>Category<select name="category" required><option value="">Choose a category</option>{projectCategories.map(c=><option>{c}</option>)}</select></label></fieldset><fieldset><legend><span>03</span> Finishing touches</legend><label>Social Handle <span class="quiet">(optional)</span><input name="social" maxlength="200" placeholder="@yourhandle — include the platform"/></label><label>Image / Thumbnail <span class="quiet">(optional)</span><input name="image" type="file" accept="image/jpeg,image/png,image/webp"/><span class="field-help">JPG, PNG, or WebP, up to 500 KB. Use an image you have permission to share.</span></label><label>Notes <span class="quiet">(optional)</span><textarea name="notes" rows="3" maxlength="2000" placeholder="Anything else you’d like me to know?"></textarea><span class="field-help">Private notes for the review.</span></label></fieldset><label class="honeypot" aria-hidden="true">Leave this empty<input name="company" tabindex="-1" autocomplete="off"/></label><label class="consent"><input name="consent" type="checkbox" required/><span>I confirm that I own or am authorized to submit this project and allow Digivated to display the submitted information and project image.</span></label><p class="quiet">Submitting does not guarantee a feature or repost. Your submission is stored privately for review. Only approved project details and images are published.</p><button class="button primary" type="submit" disabled>Submit Your Project</button><noscript>Enable JavaScript to submit your project securely.</noscript><p class="form-status" id="submission-status" role="status" aria-live="polite" tabindex="-1"></p></form><div class="submission-note"><p class="eyebrow">What happens next</p><h2>A little care goes into every feature.</h2><ol><li>Share a working link and a clear description of your project.</li><li>I review submissions before adding them to Discover.</li><li>Selected projects may also be featured across Digivated socials.</li></ol><p class="quiet">No accounts to create. No popularity contest. Just a place for interesting work to be found.</p><a class="button" href="/discover">Explore the directory</a></div></div><script>import '../scripts/submission.js';</script></Platform>
