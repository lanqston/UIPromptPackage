---
import Platform from '../layouts/Platform.astro';
import { projectCategories } from '../data/community.mjs';
import '../styles/submission-flow.css';
---
<Platform title="Submit Your Project">
  <header class="page-intro submission-intro">
    <p class="eyebrow">Share your work</p>
    <h1>Submit a project.</h1>
    <p class="lede">Tell us what you built. Submissions are free to send and reviewed before anything appears on Digivated.</p>
  </header>

  <div class="submission-layout">
    <form class="submission-form" id="project-form" action="/api/submissions" method="post">
      <div id="submission-account-callout" class="submission-account-callout">
        <span class="submission-step-label">Before you begin</span>
        <strong>Create a free account to submit</strong>
        <p>Sign in to send your project, track its review, and read private feedback. You can complete the form after signing in.</p>
        <div class="submission-account-actions"><a class="button primary" href="/login?mode=signup">Create an account</a><a href="/login">Already have one? Sign in</a></div>
      </div>
      <p id="submission-account-status" class="submission-account-status" role="status" aria-live="polite">An account is required to submit a project.</p>

      <fieldset class="submission-intent">
        <legend><span class="submission-step-label">01 / Submission</span>Choose how to share</legend>
        <p class="submission-section-help">Free directory review is the standard option. Select a membership feature or paid promotion only if you already have one.</p>
        <label>Submission type
          <select name="submissionType" id="submission-type">
            <option value="directory">Free directory review</option>
            <option value="founding-feature">Included with Founding Membership</option>
            <option value="promotion">Paid promotion, already purchased</option>
          </select>
        </label>
        <div id="membership-fields" class="submission-option-detail" hidden><p>Sign in on the <a href="/founding-members#member-sign-in">membership page</a> first. This uses your one included feature, with no extra payment. Review is required; a feature is never guaranteed.</p></div>
        <div id="promotion-fields" class="submission-option-detail" hidden>
          <p>Complete your <a href="https://digivated.gumroad.com/l/digivated-promo" target="_blank" rel="noopener noreferrer">Gumroad promo purchase ↗</a> before submitting. Use the same email below as your checkout so we can match it.</p>
          <label>Gumroad order reference<input name="promotionReceipt" id="promotion-receipt" maxlength="120" autocomplete="off" aria-describedby="promotion-receipt-help" disabled/></label>
          <p class="field-help" id="promotion-receipt-help">Copy the order reference from your receipt. If none is shown, enter “Match by checkout email”. Do not enter a license key or payment details.</p>
          <label class="consent"><input name="promotionPurchased" id="promotion-purchased" type="checkbox" disabled/><span>I purchased the Digivated promo and understand that my purchase and project must be reviewed before promotion.</span></label>
          <p class="field-help">Receipt details stay private. A purchase does not automatically publish a project or guarantee results.</p>
        </div>
      </fieldset>

      <fieldset>
        <legend><span class="submission-step-label">02 / Project details</span>Tell us about your project</legend>
        <p class="submission-section-help">A working link and a plain description help people understand what you made.</p>
        <label>Project name<input name="name" placeholder="What’s your project called?" maxlength="120" required/></label>
        <label>Project URL<input name="url" type="url" placeholder="https://your-project.com" maxlength="500" required/></label>
        <label>Project description<textarea name="description" rows="4" minlength="20" maxlength="600" required placeholder="What does it do, and who is it for?"></textarea><span class="field-help">20–600 characters. Describe what someone can use it for.</span></label>
        <label>Category<select name="category" required><option value="">Choose a category</option>{projectCategories.map(c=><option>{c}</option>)}</select></label>
      </fieldset>

      <fieldset>
        <legend><span class="submission-step-label">03 / Image</span>Add a project image</legend>
        <p class="submission-section-help">At least one image is required for your project card.</p>
        <label>Project image <span class="quiet">(required)</span><input name="image" id="project-image" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="project-image-help" required/><span class="field-help" id="project-image-help">JPG, PNG, or WebP, up to 500 KB. Use an image you have permission to share.</span></label>
        <div id="project-image-preview" class="submission-image-preview" hidden><img alt="Selected project image preview"/><span id="project-image-name"></span></div>
      </fieldset>

      <fieldset>
        <legend><span class="submission-step-label">04 / Contact</span>About you</legend>
        <p class="submission-section-help">We’ll use these details to review your submission. Your email stays private.</p>
        <div class="form-row"><label>Creator name<input name="creator" placeholder="Your name" autocomplete="name" maxlength="100" required/></label><label>Email<input name="email" placeholder="you@example.com" type="email" autocomplete="email" maxlength="254" required/><span class="field-help">Use the email linked to your account.</span></label></div>
        <label>Social handle <span class="quiet">(optional)</span><input name="social" maxlength="200" placeholder="@yourhandle — include the platform"/></label>
        <label>Notes for the review <span class="quiet">(optional)</span><textarea name="notes" rows="3" maxlength="2000" placeholder="Anything else you’d like us to know?"></textarea><span class="field-help">Only the review team sees these notes.</span></label>
      </fieldset>

      <div class="submission-review">
        <h2>Ready to send?</h2>
        <p>We review every submission. Your project is private until approved; submitting does not guarantee a feature or repost.</p>
        <label class="honeypot" aria-hidden="true">Leave this empty<input name="company" tabindex="-1" autocomplete="off"/></label>
        <label class="consent"><input name="consent" type="checkbox" required/><span>I confirm that I own or am authorized to submit this project and allow Digivated to display the submitted information and project image.</span></label>
        <button class="button primary" type="submit" disabled>Sign in to submit your project</button>
        <noscript>Enable JavaScript to submit your project securely.</noscript>
        <p class="form-status" id="submission-status" role="status" aria-live="polite" tabindex="-1"></p>
      </div>
    </form>

    <aside class="submission-note" aria-labelledby="submission-guide-title">
      <p class="eyebrow">Quick guide</p>
      <h2 id="submission-guide-title">What you’ll need</h2>
      <ul><li>A free Digivated account</li><li>A working project link</li><li>A clear description and category</li><li>One JPG, PNG, or WebP image under 500 KB</li></ul>
      <div class="submission-note-divider"><h3>After you send it</h3><p>We review your project before it appears in Discover. You can track its status and private feedback in <a href="/account">Your Projects</a>.</p></div>
      <p class="submission-options-link">Have a membership or promo purchase? <a href="/promote">See the options →</a></p>
    </aside>
  </div>
  <script>import '../scripts/submission.js';</script>
</Platform>
