---
import Platform from '../../layouts/Platform.astro';
import EmptyState from '../../components/EmptyState.astro';
import { resourceCategories } from '../../data/community.mjs';
---
<Platform title="Resources"><header class="page-intro"><p class="eyebrow">The knowledge library</p><h1>Resources &amp; Ideas</h1><p class="lede">Practical resources for technology, creative work, and building something of your own. Save a little time. Learn something useful.</p></header><div class="browse-controls" data-directory="resources"><label>Search resources<input id="directory-search" type="search" placeholder="Find an idea, topic, or tool"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{resourceCategories.map(c=><option>{c}</option>)}</select></label></div><p id="directory-status" class="results-status" role="status">Loading resources…</p><div data-live-resources><div class="resource-grid" data-live-list>
<article class="resource-card" data-resource data-builtin-resource data-resource-url="/ui-ux-prompt-packet" data-category="UI/UX" data-search="ui/ux prompt packet promptpackage prompts design websites apps toolkit digivated">
<span class="tag">UI/UX</span><h3><a href="/ui-ux-prompt-packet">UI/UX Prompt Packet</a></h3>
<p>75 practical prompts, workflows, and checklists to help you improve websites and apps with AI.</p>
<p class="quiet">Made by Digivated · 3 free prompts to try</p><a class="button" href="/ui-ux-prompt-packet">Explore the packet</a>
</article>
</div><div id="directory-empty" data-live-empty hidden><EmptyState title="The library is taking shape." description="No resources to show yet. Articles and useful tools will appear here as they’re published."/></div><p class="quiet" data-live-status role="status"></p><noscript><p>Enable JavaScript to search and load additional published resources.</p></noscript></div><script>import '../../scripts/directory.js'; import '../../scripts/live-content.js';</script></Platform>
