---
import Platform from '../../layouts/Platform.astro';
import EmptyState from '../../components/EmptyState.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resourceCategories } from '../../data/community.mjs';
import resources from '../../data/resources.json';
import { cardIconMarkup } from '../../lib/card-icons.mjs';
---
<Platform title="Explore resources"><header class="page-intro"><p class="eyebrow">TECH &amp; AI / MARKETS / TOOLS</p><h1>Explore what’s useful.</h1><p class="lede">Browse practical guides in technology and AI, markets, tools and security, design, creator growth, and digital products. Pick a topic or search for what you need.</p></header><div class="browse-controls" data-directory="resources"><label>Search resources<input id="directory-search" type="search" placeholder="Find an idea, topic, or tool"/></label><label>Topic<select id="directory-category"><option value="">All topics</option>{resourceCategories.map(c=><option>{c}</option>)}</select></label></div><p id="directory-status" class="results-status" role="status">Loading resources…</p><div data-live-resources><div class="resource-grid" data-live-list>
<article class="resource-card" data-resource data-builtin-resource data-resource-url="/ui-ux-prompt-packet" data-category="Design &amp; UX" data-search="design ux ui/ux prompt packet promptpackage prompts websites apps toolkit digivated">
<div class="resource-copy"><span class="tag">Design &amp; UX</span><h3><a href="/ui-ux-prompt-packet">UI/UX Prompt Packet</a></h3><p class="resource-description">75 practical prompts, workflows, and checklists to help you improve websites and apps with AI.</p><p class="resource-meta">Made by Digivated · 3 free prompts to try</p><a class="card-open" href="/ui-ux-prompt-packet">Explore the packet <span aria-hidden="true">↗</span></a><div class="card-actions"><button class="card-icon" type="button" data-comment-type="resource" data-comment-id="builtin-ui-ux-prompt-packet" aria-label="Read or leave a comment on the Prompt Packet" title="Comments"><span set:html={cardIconMarkup('comment')}/><span class="sr-only">Comments</span></button><button class="card-icon" type="button" data-share-url="/ui-ux-prompt-packet" aria-label="Share the Prompt Packet" title="Share"><span set:html={cardIconMarkup('share')}/><span class="sr-only">Share</span></button><button class="card-icon" type="button" data-like-type="resource" data-like-id="builtin-ui-ux-prompt-packet" aria-label="Like the Prompt Packet" title="Like"><span set:html={cardIconMarkup('like')}/><span class="card-count" data-like-count></span></button><button class="card-icon card-save" type="button" data-save-type="resource" data-save-id="builtin-ui-ux-prompt-packet" aria-label="Save to collection" title="Save to collections"><span set:html={cardIconMarkup('save')}/><span class="sr-only" data-save-label>Save</span></button></div></div>
</article>
{resources.filter(resource=>resource.status==='published').map(resource=><ResourceCard resource={resource}/>)}
</div><div id="directory-empty" data-live-empty hidden><EmptyState title="The library is taking shape." description="No resources to show yet. Articles and useful tools will appear here as they’re published."/></div><p class="quiet" data-live-status role="status"></p><noscript><p>Enable JavaScript to search and load additional published resources.</p></noscript></div><script>import '../../scripts/directory.js'; import '../../scripts/live-content.js';</script></Platform>

