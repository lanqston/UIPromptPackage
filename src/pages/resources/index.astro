---
import Platform from '../../layouts/Platform.astro';
import EmptyState from '../../components/EmptyState.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import resources from '../../data/resources.json';
import { resourceCategories } from '../../data/community.mjs';
const published=resources.filter(r=>r.status==='published').sort((a,b)=>b.date.localeCompare(a.date));
---
<Platform title="Resources"><header class="page-intro"><p class="eyebrow">The knowledge library</p><h1>A useful idea.<br/>A clearer next step.</h1><p class="lede">Practical resources for technology, creative work, and building something of your own. Save a little time. Learn something useful.</p></header><div class="browse-controls" data-directory="resources"><label>Search resources<input id="directory-search" type="search" placeholder="Find an idea, topic, or tool"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{resourceCategories.map(c=><option>{c}</option>)}</select></label><div><span class="tiny">Thoughtfully collected</span><p class="quiet">New resources, when they’re ready.</p></div></div><p id="directory-status" class="results-status" role="status">{published.length} resources</p><div class="resource-grid">{published.map(resource=><ResourceCard resource={resource}/>)}</div><div id="directory-empty" hidden={published.length>0}><EmptyState title="The library is taking shape." description="No resources to show yet. Articles and useful tools will appear here as they’re published."/></div><div class="category-note">{resourceCategories.map(c=><span>{c}</span>)}</div><script>import '../../scripts/directory.js';</script></Platform>
