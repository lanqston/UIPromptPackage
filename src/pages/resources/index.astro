---
import Platform from '../../layouts/Platform.astro';
import EmptyState from '../../components/EmptyState.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resourceCategories } from '../../data/community.mjs';
import resources from '../../data/resources.json';
---
<Platform title="Explore resources"><header class="page-intro"><p class="eyebrow">TECH / AI / MARKETS / TOOLS</p><h1>Explore what’s useful.</h1><p class="lede">Clear guides for making sense of tech and AI, checking market stories, choosing useful tools, and bringing good ideas to life. Pick a topic or search for what you need.</p></header><div class="browse-controls" data-directory="resources"><label>Search resources<input id="directory-search" type="search" placeholder="Find an idea, topic, or tool"/></label><label>Category<select id="directory-category"><option value="">All categories</option>{resourceCategories.map(c=><option>{c}</option>)}</select></label></div><p id="directory-status" class="results-status" role="status">Loading resources…</p><div data-live-resources><div class="resource-grid" data-live-list>
<article class="resource-card" data-resource data-builtin-resource data-resource-url="/ui-ux-prompt-packet" data-category="UI/UX" data-search="ui/ux prompt packet promptpackage prompts design websites apps toolkit digivated">
<span class="tag">UI/UX</span><h3><a href="/ui-ux-prompt-packet">UI/UX Prompt Packet</a></h3>
<p>75 practical prompts, workflows, and checklists to help you improve websites and apps with AI.</p>
<p class="quiet">Made by Digivated · 3 free prompts to try</p><a class="button" href="/ui-ux-prompt-packet">Explore the packet</a><button class="button" type="button" data-save-type="resource" data-save-id="builtin-ui-ux-prompt-packet">Save</button>
</article>
{resources.filter(resource=>resource.status==='published').map(resource=><ResourceCard resource={resource}/>)}
</div><div id="directory-empty" data-live-empty hidden><EmptyState title="The library is taking shape." description="No resources to show yet. Articles and useful tools will appear here as they’re published."/></div><p class="quiet" data-live-status role="status"></p><noscript><p>Enable JavaScript to search and load additional published resources.</p></noscript></div><script>import '../../scripts/directory.js'; import '../../scripts/live-content.js';</script></Platform>

