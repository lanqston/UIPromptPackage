---
import Platform from '../../layouts/Platform.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import ResourceBlock from '../../components/ResourceBlock.astro';
import CardStats from '../../components/CardStats.astro';
import CardActions from '../../components/CardActions.astro';
import resources from '../../data/resources.json';
import { resourcePathInfo } from '../../data/learning-paths.mjs';
export function getStaticPaths() { return resources.filter(r=>r.status==='published').map(resource=>({params:{slug:resource.slug},props:{resource}})); }
const {resource}=Astro.props;
const learning = resourcePathInfo(resource);
const nextGuide = resources.find(r=>r.status==='published' && r.slug===learning.next);
const related=resources.filter(r=>r.status==='published' && resource.related?.includes(r.slug));
---
<Platform title={resource.title} description={resource.description}><header class="page-intro" data-builtin-view data-resource-view-id={resource.slug}><a href="/resources">← All resources</a><p class="eyebrow">{resource.category}</p><h1>{resource.title}</h1><p class="lede">{resource.description}</p><CardStats resource={resource} fullDate/><CardActions id={resource.slug} title={resource.title} url={`/resources/${resource.slug}`}/></header><article class="article-body">{resource.coverImage&&<img class="article-cover" src={resource.coverImage} alt={resource.coverAlt||''} width="1000" height="600"/>}{resource.content.map(block=><ResourceBlock block={block}/>)}{resource.source&&<p class="resource-source">A little more to explore <a href={resource.source.url} target="_blank" rel="noopener noreferrer">{resource.source.label} ↗</a></p>}{learning.path && <nav class="resource-next" aria-label="Continue learning"><p class="resource-note">{learning.path.label} · Guide {learning.step} of {learning.total}</p>{nextGuide ? <><strong>Next guide</strong><a href={`/resources/${nextGuide.slug}`}>{nextGuide.title} →</a></> : <><strong>Ready to explore another goal?</strong><a href="/resources">Browse all learning goals →</a></>}<a class="resource-path-link" href={`/resources?path=${learning.path.id}`}>See this learning path</a></nav>}</article>{related.length>0&&<section class="platform-section"><h2>Keep exploring</h2><div class="resource-grid">{related.map(resource=><ResourceCard resource={resource}/>)}</div></section>}</Platform>

