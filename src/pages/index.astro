---
import HeroComposition from '../components/HeroComposition.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Platform from '../layouts/Platform.astro';
import EmptyState from '../components/EmptyState.astro';
import LiveProjects from '../components/LiveProjects.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { resourceCategories } from '../data/community.mjs';
---
<Platform>
<section class="platform-hero"><div class="hero-copy"><p class="eyebrow">DIGIVATED · A space for your next chapter</p><h1>Build. Share.<br/><em>Connect.</em></h1><p class="lede">A space to discover useful ideas, share what you’re building, and connect with people creating something of their own.</p><div class="actions"><a class="button primary" href="/submit-project">Submit Your Project</a><a class="button" href="/discover">Explore Projects</a></div><p class="hero-footnote">Small beginnings. Interesting possibilities.</p></div><HeroComposition/></section>
<section class="platform-section"><SectionHeader eyebrow="In the spotlight" title="Featured Build" href="/discover?view=featured" label="Explore featured projects"/><LiveProjects mode="featured" limit={1} title="A little space for your big idea." description="Our first Featured Build is still to come. Share what you’re making for a chance to be featured here." href="/submit-project" label="Submit Your Project"/><p class="feature-invitation">Want to be featured? Share your project for review.</p></section>
<section class="platform-section"><SectionHeader eyebrow="From the community" title="What People Are Building" href="/discover" label="Explore all projects"/><LiveProjects limit={6} compact title="Good things start somewhere." description="The directory is open for submissions. Reviewed projects will appear here as the community grows." href="/submit-project" label="Share what you’re building"/></section>
<section class="platform-section picks-section"><div><p class="eyebrow">Digivated Picks</p><h2>Projects worth checking out.</h2><p>A personal selection of projects that catch my eye — useful ideas, thoughtful design, and people making things happen.</p><p class="quiet">Selected projects may also be featured across Digivated socials.</p><a class="button" href="/discover?view=picks">Explore Digivated Picks</a></div><div><LiveProjects mode="picks" limit={1} compact title="The first picks are on their way." description="A considered collection takes time. Check back as new projects are reviewed."/></div></section>
<section class="platform-section"><ProductCard product={products[0]}/></section>
<section class="platform-section"><SectionHeader eyebrow="Ideas to keep close" title="Latest from Digivated" href="/resources" label="Visit the resource library"/><div data-live-resources data-limit="3"><div class="resource-grid" data-live-list hidden></div><div data-live-empty><EmptyState compact title="A useful little library, in the making." description="Practical notes, tools, and ideas for building online. Our first resources will appear here when they’re ready."/></div><p class="quiet" data-live-status role="status"></p></div><div class="category-note">{resourceCategories.map(category=><a href={`/resources?category=${encodeURIComponent(category)}`}>{category}</a>)}</div></section>
<script>import '../scripts/live-content.js';</script></Platform>
