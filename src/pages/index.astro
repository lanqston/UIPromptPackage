---
import Platform from '../layouts/Platform.astro';
import LiveProjects from '../components/LiveProjects.astro';
---
<Platform title="Discover, learn, and share" description="Explore independent projects, practical resources, carousels, and share your work on Digivated.">
  <div class="compact-home">
    <section class="home-start" aria-labelledby="home-start-heading"><p class="eyebrow">WELCOME TO DIGIVATED</p><h1 id="home-start-heading">Discover. Learn. Build.</h1><p>Explore independent projects and useful technology resources, or share what you’re making.</p><div class="home-paths"><a href="/discover"><strong>Explore projects</strong><span>Find independent tools and ideas.</span><b>Browse projects <span aria-hidden="true">→</span></b></a><a href="/resources"><strong>Learn something</strong><span>Read practical resources and carousels.</span><b>View resources <span aria-hidden="true">→</span></b></a><a href="/submit-project"><strong>Share your work</strong><span>Submit a project for review.</span><b>Submit a project <span aria-hidden="true">→</span></b></a></div></section>
    <section id="projects" class="compact-home-projects" aria-labelledby="home-heading"><div class="compact-project-heading"><h2 id="home-heading">Featured projects</h2><a href="/discover">View all projects <span aria-hidden="true">→</span></a></div>
      <LiveProjects mode="featured" limit={4} compact title="The next discovery is still to come." description="Featured projects will appear here after review." href="/submit-project" label="Submit your project"/>
    </section>
  </div>
  <script>import '../scripts/live-content.js';</script>
</Platform>
