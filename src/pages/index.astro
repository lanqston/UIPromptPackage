---
import Platform from '../layouts/Platform.astro';
import LiveProjects from '../components/LiveProjects.astro';
import ResourcesLibrary from '../components/ResourcesLibrary.astro';
---
<Platform title="Tech, AI, markets & what’s next" description="Explore tech, AI, markets, useful tools, and independent projects with Digivated.">
  <div class="home-container mx-auto px-6">
    <section class="revamp-hero" aria-labelledby="home-heading">
      <div class="hero-copy">
        <p class="section-kicker hero-kicker"><span class="signal-star" aria-hidden="true">✳</span> A CLEARER WAY TO EXPLORE WHAT’S NEXT</p>
        <h1 class="discovery-headline" id="home-heading">Stay curious about <em>what’s next.</em></h1>
        <p class="lede">Come explore ideas in tech, AI, and markets, and meet the independent builders bringing the next big things to life.</p>
        <div class="actions"><a class="button primary" href="/resources">Explore ideas <span aria-hidden="true">↗</span></a><a class="button hero-explore" href="/discover">Discover projects <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="signal-stage"><div class="signal-display" aria-label="Digivated explores technology, AI, markets, and useful tools">
        <div class="signal-top"><span><span class="signal-dot"></span> DIGIVATED / THE DIGITAL FRONTIER</span><span>STAY CURIOUS</span></div>
        <div class="signal-core"><div class="signal-orbit"><div class="signal-emblem" aria-hidden="true"><span class="signal-emblem-back"></span><span class="signal-emblem-face"><span class="signal-watermark"></span></span></div><span class="orbit-label orbit-label-a">TECH</span><span class="orbit-label orbit-label-b">AI</span><span class="orbit-label orbit-label-c">MARKETS</span><span class="orbit-label orbit-label-d">TOOLS</span></div></div>
        <div class="signal-bottom"><span>EXPLORE · UNDERSTAND · BUILD</span><span>WHAT’S NEXT? ↗</span></div>
      </div></div>
      <nav class="home-topics" aria-label="Explore Digivated topics">
        <a href="/resources?category=Tech">Technology <span aria-hidden="true">↗</span></a>
        <a href="/resources?category=AI">Artificial intelligence <span aria-hidden="true">↗</span></a>
        <a href="/resources?category=Markets%20%26%20Investing">Markets &amp; investing <span aria-hidden="true">↗</span></a>
        <a href="/resources?category=Useful%20Tools">Useful tools <span aria-hidden="true">↗</span></a>
      </nav>
    </section>

    <ResourcesLibrary/>

    <section class="journey-section" aria-labelledby="journey-heading">
      <div class="journey-intro"><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> HOW DIGIVATED WORKS</p><h2 id="journey-heading">Follow an idea <em>further.</em></h2><p>There’s no complicated process. Browse what interests you, find people making things, and add your own work when you’re ready.</p></div>
      <ol class="journey-steps">
        <li><span class="journey-icon" aria-hidden="true">✳</span><div><h3>Explore a topic</h3><p>Start with tech, AI, markets, or useful tools in the resource library.</p></div><a href="/resources" aria-label="Browse resources">↗</a></li>
        <li><span class="journey-icon" aria-hidden="true">✳</span><div><h3>Discover a project</h3><p>Meet independent builders and save the projects you want to revisit.</p></div><a href="/discover" aria-label="Explore projects">↗</a></li>
        <li><span class="journey-icon" aria-hidden="true">✳</span><div><h3>Share what you make</h3><p>Submit a project for review. Approved work can join the community directory.</p></div><a href="/submit-project" aria-label="Submit a project">↗</a></li>
      </ol>
    </section>

    <section id="projects" class="home-section community-builds" aria-labelledby="community-heading">
      <div class="home-section-heading"><div><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> THE COMMUNITY</p><h2 id="community-heading">Ideas worth <em>discovering.</em></h2><p>Explore projects from people making something of their own. Every submission is reviewed before it appears.</p></div><a class="section-link" href="/discover">Browse projects <span aria-hidden="true">↗</span></a></div>
      <LiveProjects limit={4} filterable compact title="The next discovery is still to come." description="Reviewed community projects will appear here. Have something you’re building? Send it in for free." href="/submit-project" label="Submit your project"/>
    </section>

    <section class="home-product" aria-labelledby="home-product-heading"><div><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> MADE BY DIGIVATED</p><h2 id="home-product-heading">Turn an idea into <em>something real.</em></h2><p>The UI/UX Prompt Packet brings 75 prompts and step-by-step guidance to your next website or app. Try three prompts free before deciding whether the full packet is for you.</p><div class="actions"><a class="button primary" href="/ui-ux-prompt-packet">Explore the packet ↗</a><a class="text-link" href="/access">Already purchased? Open access →</a></div></div><div class="packet-display" aria-hidden="true"><span>THE UI/UX PROMPT PACKET</span><strong>75<span> prompts</span></strong><span>FROM IDEA → INTERFACE</span></div></section>

    <section class="share-next" aria-labelledby="share-heading"><div><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> YOUR TURN</p><h2 id="share-heading">Building something <em>worth sharing?</em></h2><p>Submit your project for free. Want to learn about paid promotion? That’s a separate option after you’ve seen how submissions work.</p></div><div class="share-actions"><a class="button primary" href="/submit-project">Submit a project ↗</a><a href="/promote">About promotion →</a></div></section>

    <section class="home-faq" aria-labelledby="faq-heading"><div><p class="section-kicker"><span class="signal-star" aria-hidden="true">✳</span> QUICK ANSWERS</p><h2 id="faq-heading">Good to <em>know.</em></h2></div><div class="faq-list"><details><summary>What is Digivated?</summary><p>A place to explore ideas in tech, AI, markets, and useful tools, alongside projects from independent creators.</p></details><details><summary>Can I submit my project for free?</summary><p>Yes. You can send in a project for review at no cost. A submission does not guarantee that it will be published or featured.</p></details><details><summary>Is the Prompt Packet free?</summary><p>Three prompts are free to try. The full 75-prompt packet is a paid digital product.</p></details><details><summary>How do I save things for later?</summary><p>Use Save on a project or resource to add it to a private collection on this device.</p></details></div></section>
  </div>
  <script>import '../scripts/live-content.js';</script>
</Platform>
