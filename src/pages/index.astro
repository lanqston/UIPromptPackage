---
import Platform from '../layouts/Platform.astro';
import EmptyState from '../components/EmptyState.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProductCard from '../components/ProductCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import projects from '../data/projects.json';
import products from '../data/products.json';
import resources from '../data/resources.json';
import { publicProjects, resourceCategories } from '../data/community.mjs';
const approved = publicProjects(projects);
const featured = approved.find(p=>p.status==='featured');
const picks = approved.filter(p=>p.pick);
const latest = resources.filter(r=>r.status==='published').sort((a,b)=>b.date.localeCompare(a.date)).slice(0,3);
---
<Platform>
<section class="platform-hero"><p class="eyebrow">DIGIVATED · A space for your next chapter</p><h1>Build. Share.<br/><em>Connect.</em></h1><p class="lede">A space to discover useful ideas, share what you’re building, and connect with people creating something of their own.</p><div class="actions"><a class="button primary" href="/submit-project">Submit Your Project ↗</a><a class="button" href="/discover">Explore Projects →</a></div><p class="hero-footnote">Small beginnings. Interesting possibilities.</p></section>
<section class="platform-section"><div class="section-top"><div><p class="eyebrow">In the spotlight</p><h2>Featured Build</h2></div><a href="/discover?view=featured">Explore featured projects →</a></div>{featured?<ProjectCard project={featured}/>:<EmptyState title="A little space for your big idea." description="Our first Featured Build is still to come. Share what you’re making for a chance to be featured here." href="/submit-project" label="Submit Your Project"/>}<p class="feature-invitation">Want to be featured? <a href="/submit-project">Submit Your Project →</a></p></section>
<section class="platform-section"><div class="section-top"><div><p class="eyebrow">From the community</p><h2>What People Are Building</h2></div><a href="/discover">Explore all projects →</a></div>{approved.length?<div class="project-grid">{approved.slice(0,6).map(project=><ProjectCard project={project}/>)}</div>:<EmptyState compact title="Good things start somewhere." description="The directory is open for submissions. Reviewed projects will appear here as the community grows." href="/submit-project" label="Share what you’re building"/>}</section>
<section class="platform-section picks-section"><div><p class="eyebrow">Digivated Picks</p><h2>Projects worth checking out.</h2><p>A personal selection of projects that catch my eye — useful ideas, thoughtful design, and people making things happen.</p><p class="quiet">Selected projects may also be featured across Digivated socials.</p><a class="text-link" href="/discover?view=picks">Explore Digivated Picks →</a></div><div>{picks.length?<ProjectCard project={picks[0]}/>:<EmptyState compact title="The first picks are on their way." description="A considered collection takes time. Check back as new projects are reviewed."/>}</div></section>
<section class="platform-section"><ProductCard product={products[0]}/></section>
<section class="platform-section"><div class="section-top"><div><p class="eyebrow">Ideas to keep close</p><h2>Latest from Digivated</h2></div><a href="/resources">Visit the resource library →</a></div>{latest.length?<div class="resource-grid">{latest.map(resource=><ResourceCard resource={resource}/>)}</div>:<EmptyState compact title="A useful little library, in the making." description="Practical notes, tools, and ideas for building online. Our first resources will appear here when they’re ready."/>}<div class="category-note">{resourceCategories.map(category=><span>{category}</span>)}</div></section>
</Platform>
