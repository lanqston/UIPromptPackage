---
import Platform from '../layouts/Platform.astro';
import '../styles/project-account.css';
---
<Platform title="Email preferences" description="Confirm your Digivated weekly email subscription.">
 <header class="page-intro"><p class="eyebrow">DIGIVATED EMAILS</p><h1>Weekly project updates</h1></header>
 <section class="project-account-card"><p id="confirm-status" role="status">Confirm that you want a weekly email about new featured projects.</p><button class="button primary" id="confirm-weekly" type="button">Confirm weekly emails</button><p><a href="/account">Manage email preferences</a></p></section>
 <script>const button=document.getElementById('confirm-weekly'),status=document.getElementById('confirm-status');const token=new URLSearchParams(location.search).get('token');if(!token){button.hidden=true;status.textContent='This confirmation link is incomplete.';}button.onclick=async()=>{button.disabled=true;try{const response=await fetch('/api/return-emails?action=confirm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token})});const data=await response.json();if(!response.ok)throw Error(data.error||'Please try again.');status.textContent='Confirmed. You will receive the weekly email when new projects are featured.';button.hidden=true;history.replaceState(null,'','/email-preferences');}catch(error){status.textContent=error.message;button.disabled=false;}};</script>
</Platform>
