---
import '../styles/global.css';
const {title='UI Prompt Package',section='home'}=Astro.props;
const links=[['start','Start Here'],['library','Prompt library'],['fixes','Help me choose'],['builder','Customize a prompt'],['workflows','Step-by-step guides'],['checklists','Review checklists'],['learn','Learn the basics'],['toolkit','My saved work']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content="Practical prompts that help beginners improve websites and apps with AI. Choose a prompt, add your details, and review the result."/><meta name="theme-color" content="#faf9f6"/><link rel="icon" href="/favicon.svg"/><title>{title} · UI Prompt Package</title></head>
<body data-section={section}><a class="skip" href="#main">Skip to content</a>
<header class="topbar"><a class="brand" href="/" aria-label="UI Prompt Package home"><span class="mark" aria-hidden="true">P<span>.</span></span><span>UI Prompt Package<span class="brand-caption">A practical playbook for beginners</span></span></a><span class="edition" id="edition-label">Free edition</span><a href="/access" class="button small access-link">Edition access</a><button id="menu-toggle" class="button small menu-toggle" aria-expanded="false" aria-controls="site-navigation">Menu</button></header>
<div class="shell"><aside id="site-navigation"><nav aria-label="Main navigation"><a href="/" aria-current={section==='home'?'page':undefined}>Home</a>{links.map(([slug,label])=><a href={'/'+slug} aria-current={section===slug?'page':undefined}>{label}</a>)}</nav><div class="side-note"><span class="tiny">NEW TO AI PROMPTS?</span><p>Start with one screen and one thing to improve.</p><a href="/start">Follow the quick guide</a></div></aside>
<main id="main" tabindex="-1"><slot/></main></div><footer><a class="footer-brand" href="/">UI Prompt Package</a><span>Made by Langston McCovery</span><div class="footer-links"><a href="/about">About Langston</a><a href="/start">Start Here</a><a href="/access">Access & privacy</a></div></footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/app.js';</script>
</body></html>
