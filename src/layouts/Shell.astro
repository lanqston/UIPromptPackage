---
import '../styles/global.css';
const {title='UI Prompt Package',section='home'}=Astro.props;
const links=[['library','Prompt library'],['fixes','Guided fixes'],['builder','Prompt builder'],['workflows','Workflows'],['checklists','Checklists'],['learn','Learn the basics'],['toolkit','My toolkit']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="A practical UI prompting playbook for indie builders. Find the right prompt, adapt it to your app, and check the result."/><meta name="theme-color" content="#f5f3ed"/><link rel="icon" href="/favicon.svg"/><title>{title} · UI Prompt Package</title></head>
<body data-section={section}><a class="skip" href="#main">Skip to content</a>
<header class="topbar"><a class="brand" href="/" aria-label="UI Prompt Package home"><span class="mark">ui<span>p</span></span><span>UI Prompt<br/><b>Package</b></span></a><span class="edition" id="edition-label">The beginner’s playbook</span><a href="/access" class="button small">Full edition</a></header>
<div class="shell"><aside><nav aria-label="Main navigation"><a href="/" aria-current={section==='home'?'page':undefined}>Overview</a>{links.map(([slug,label],i)=><a href={'/'+slug} aria-current={section===slug?'page':undefined}><span class="nav-num">0{i+1}</span>{label}</a>)}</nav><div class="side-note"><span class="tiny">START SMALL</span><p>One screen.<br/>One clear goal.<br/>One useful change.</p><a href="/library?sample=1">Try a free prompt</a></div></aside>
<main id="main" tabindex="-1"><slot/></main></div><footer><span>UI Prompt Package</span><span>Built for better decisions, one screen at a time.</span><a href="/access">Access & privacy</a></footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/app.js';</script>
</body></html>
