---
import '../styles/global.css';
import '../styles/reference-design.css';
import '../styles/packet-theme.css';
const {title='UI Prompt Package',section='home'}=Astro.props;
const workspace=['library','fixes','builder','workflows','checklists','learn','toolkit'].includes(section);
const links=[['start','Start Here'],['library','Prompt library'],['fixes','Help me choose'],['builder','Customize a prompt'],['workflows','Step-by-step guides'],['checklists','Review checklists'],['learn','Learn the basics'],['toolkit','My saved work']];
const siteTitle=`${title} · UI Prompt Package`;
const socialTitle='Digivated UI Prompt Package';
const siteDescription='A beginner-friendly UI prompt package with 75 detailed prompts, workflows, checklists, and a prompt builder for improving websites and apps with AI.';
const siteUrl='https://digivated.vercel.app';
const previewImage=`${siteUrl}/digivated-tech-markets-banner.png`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={siteDescription}/><meta name="theme-color" content="#030712"/><link rel="canonical" href={siteUrl}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Digivated"/><meta property="og:title" content={socialTitle}/><meta property="og:description" content={siteDescription}/><meta property="og:url" content={siteUrl}/><meta property="og:image" content={previewImage}/><meta property="og:image:secure_url" content={previewImage}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="2172"/><meta property="og:image:height" content="724"/><meta property="og:image:alt" content="Digivated logo and UI Prompt Package."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={socialTitle}/><meta name="twitter:description" content={siteDescription}/><meta name="twitter:image" content={previewImage}/><meta name="twitter:image:alt" content="Digivated UI Prompt Package preview card."/><link rel="icon" href="/favicon.svg"/><title>{siteTitle}</title></head>
<body class="packet-workspace" data-section={section} data-surface={workspace?'workspace':'editorial'}><a class="skip" href="#main">Skip to content</a>
<div class="packet-context"><a href="/">← Back to Digivated</a><a href="/ui-ux-prompt-packet">UI/UX Prompt Packet</a></div>
<header class="topbar"><a class="brand" href="/ui-ux-prompt-packet" aria-label="Prompt Packet overview"><span class="brand-logo-wrap"><img class="brand-logo" src="/digivated-mark.svg" width="43" height="43" alt=""/></span><span>Prompt Packet<span class="brand-caption">Your design toolkit by Digivated</span></span></a><nav class="public-nav" aria-label="Packet navigation"><a href="/start">Start Here</a><a href="/library">Prompt Library</a></nav><span class="edition" id="edition-label">Free edition</span><a href="/access" class="button small access-link">Packet Access</a><a href="https://mccovery.gumroad.com/l/ui-prompt-package" class="button primary small purchase-link">Buy the packet</a><button id="menu-toggle" class="button small menu-toggle" aria-expanded="false" aria-controls="site-navigation">Tools</button></header>
<div class="shell"><aside id="site-navigation"><nav aria-label="Packet tools"><a href="/ui-ux-prompt-packet">Packet overview</a>{links.map(([slug,label])=><a href={'/'+slug} aria-current={section===slug?'page':undefined}>{label}</a>)}</nav><a class="return-access" href="/access">Already purchased? Activate your packet</a><div class="side-note"><span class="tiny">NEW TO AI PROMPTS?</span><p>Start with one screen and one thing to improve.</p><a href="/start">Follow the quick guide</a></div></aside>
<main id="main" tabindex="-1"><slot/></main></div><footer><a class="footer-brand" href="/">Back to Digivated</a><span>Made by Langston McCovery</span><a class="footer-social" href="https://www.threads.com/@digivated" target="_blank" rel="noopener noreferrer" aria-label="Digivated on Threads, @digivated"><span class="footer-logo-wrap"><img class="footer-logo" src="/digivated-mark.svg" width="34" height="34" alt=""/></span>@digivated</a><div class="footer-links"><a href="https://mccovery.gumroad.com/l/ui-prompt-package">Buy the packet</a><a href="/about-langston">About Langston</a><a href="/start">Start Here</a><a href="/access">Access & privacy</a></div></footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script is:inline src="/analytics.js"></script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script>import '../scripts/monitoring.js'; import '../scripts/app.js';</script>
<style>
.brand-logo-wrap{display:block;width:43px;height:43px;overflow:hidden;flex:none;border-radius:0;background:transparent}
.brand-logo{display:block;width:43px;height:43px;object-fit:contain;filter:invert(1)}
.footer-logo-wrap{display:block;width:34px;height:34px;overflow:hidden;border-radius:0;background:transparent}
.footer-logo{display:block;width:34px;height:34px;object-fit:contain;filter:invert(1)}
.header-social{color:var(--muted);font-size:.8125rem;font-weight:600;text-decoration:none;white-space:nowrap;padding:8px 10px;border:1px solid var(--line);border-radius:999px}
.header-social:hover{color:var(--accent);border-color:var(--accent)}
@media(max-width:600px){.brand-logo-wrap{width:36px;height:36px;border-radius:0}.brand-logo{width:36px;height:36px}.topbar .header-social{grid-column:1;grid-row:2;justify-self:start;padding:5px 9px}.topbar .purchase-link{grid-row:3}}
</style>
</body></html>

