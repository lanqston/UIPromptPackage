---
import '../styles/global.css';
import '../styles/platform.css';
import '../styles/launch-collections.css';
import '../styles/community-refresh.css';
import '../styles/experience-polish.css';
import '../styles/clean-ui.css';
import '../styles/brand-relaunch.css';
import '../styles/signal-theme.css';
import '../styles/cards.css';
import '../styles/products.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DiscoveryTools from '../components/DiscoveryTools.astro';
const { title = 'Tech. AI. Markets. What’s next.', description = 'Digivated explores technology, AI, markets, useful tools, and independent projects.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const sectionNames: Record<string,string> = { '/discover':'Projects', '/resources':'Resources', '/carousels':'Carousels', '/products':'Digital Products', '/ui-ux-prompt-packet':'Prompt Packet', '/submit-project':'Submit Project', '/account':'Your Projects', '/login':'Log in', '/promote':'Promote your project', '/about':'About', '/privacy':'Privacy & Data', '/terms':'Terms of Use' };
const breadcrumb = sectionNames[path] || title;
import '../styles/monochrome.css';
import '../styles/projects-refined.css';
import '../styles/resources-refined.css';
import '../styles/atmosphere.css';
import '../styles/light-theme.css';
import '../styles/motion.css';
import '../styles/public-polish.css';
import '../styles/studio.css';
import '../styles/discovery.css';
import '../styles/resource-expansion.css';
import '../styles/readability.css';
import '../styles/compact-navigation.css';
import '../styles/account-announcement.css';
import '../styles/feedback-dialog.css';
import '../styles/catalogue.css';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title} · Digivated</title><meta name="description" content={description}/><meta name="theme-color" content="#ffffff"/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={new URL(path, 'https://digivated.com')}/><meta property="og:title" content={`${title} · Digivated`}/><meta property="og:description" content={description}/><meta property="og:image" content="https://digivated.com/digivated-tech-markets-banner.png"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@digivatedx"/><meta name="twitter:title" content={`${title} · Digivated`}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://digivated.com/digivated-tech-markets-banner.png"/></head>
<body class:list={['platform', 'light-theme', { 'home-refresh': path === '/', 'projects-dashboard': path === '/discover', 'resources-dashboard': path === '/resources', 'community-page': path.startsWith('/community') }]}><div class="site-atmosphere" aria-hidden="true"></div><a class="skip" href="#main">Skip to content</a>
<SiteHeader/>
{path !== '/login' && path !== '/account' && path !== '/submit-project' && <aside id="account-announcement" class="account-announcement" aria-label="Digivated announcement" hidden><div class="account-announcement-copy"><span class="account-announcement-tag">NEW ON DIGIVATED</span><strong id="announcement-title">Accounts are live.</strong><span id="announcement-description">Sign up to track your projects and see feedback in one place. You can still browse without an account.</span></div><div class="account-announcement-actions"><a id="announcement-link" href="/login?mode=signup">Create an account <span aria-hidden="true">→</span></a><button type="button" id="account-announcement-close" aria-label="Dismiss announcement">×</button></div></aside>}
<main id="main" tabindex="-1">{path !== '/' && <nav class="site-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{(path.startsWith('/projects/') || path === '/launch-template') && <><a href="/discover">Projects</a><span aria-hidden="true">/</span></>}{path.startsWith('/resources/') && <><a href="/resources">Resources</a><span aria-hidden="true">/</span></>}{path.startsWith('/carousels/') && <><a href="/carousels">Carousels</a><span aria-hidden="true">/</span></>}<span aria-current="page">{breadcrumb}</span></nav>}<slot/></main>
<SiteFooter/>
<DiscoveryTools/>
<script is:inline src="/analytics.js"></script>
<script is:inline defer src="/_vercel/insights/script.js"></script><script>import '../scripts/monitoring.js'; import '../scripts/platform-ui.js'; import '../scripts/collections.js';</script>
<script>import '../scripts/motion.js'; import '../scripts/card-actions.js';</script>
<script>import '../scripts/resource-views.js';</script>
<script>import '../scripts/account-announcement.js';</script>
{path === '/' && <script is:inline>if(location.hash.includes('access_token='))location.replace('/account'+location.hash);</script>}
<script>import '../scripts/studio.js';</script>
</body></html>


