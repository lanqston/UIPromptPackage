---
import '../styles/global.css';
import '../styles/platform.css';
const { title = 'Build. Share. Connect.', description = 'A space to discover useful ideas, share what you’re building, and connect with people creating something of their own.' } = Astro.props;
const links = [['/', 'Home'], ['/discover', 'Discover'], ['/resources', 'Resources'], ['/products', 'Products'], ['/submit-project', 'Submit Project'], ['/about', 'About']];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const social = [['X @digivatedx', 'https://x.com/digivatedx'], ['Threads @digivated', 'https://www.threads.com/@digivated'], ['Instagram @digivated', 'https://www.instagram.com/digivated/'], ['Pinterest @digivated', 'https://www.pinterest.com/digivated/']];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title} · Digivated</title><meta name="description" content={description}/><meta name="theme-color" content="#f7f4ef"/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={new URL(path, 'https://digitalpromptpackage.vercel.app')}/><meta property="og:title" content={`${title} · Digivated`}/><meta property="og:description" content={description}/><meta property="og:image" content="https://digitalpromptpackage.vercel.app/digivated-logo-site.jpg"/></head>
<body class="platform"><a class="skip" href="#main">Skip to content</a>
<header class="platform-header"><a class="platform-brand" href="/" aria-label="Digivated home"><span class="logo-crop"><img src="/digivated-logo-site.jpg" width="44" height="44" alt=""/></span><span>DIGIVATED<span class="brand-subtitle">Build. Share. Connect.</span></span></a><nav class="desktop-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav><details class="mobile-menu"><summary>Menu <span aria-hidden="true">＋</span></summary><nav aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<a href="/access">Already purchased?</a></nav></details></header>
<main id="main" tabindex="-1"><slot/></main>
<footer class="platform-footer"><div><a class="platform-brand" href="/"><span class="logo-crop"><img src="/digivated-logo-site.jpg" width="44" height="44" alt="Digivated logo"/></span>DIGIVATED</a><p>Build. Share. Connect.</p><p class="quiet">For people creating something of their own.</p></div><nav aria-label="Footer navigation"><span class="tiny">Explore</span>{links.filter(([href])=>href!=='/').map(([href,label])=><a href={href}>{label}</a>)}</nav><nav aria-label="Social links"><span class="tiny">Find us elsewhere</span>{social.map(([label,href])=><a href={href} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>)}</nav><div class="footer-bottom"><span>© {new Date().getFullYear()} Digivated</span><a href="/access">UI/UX Prompt Packet · Already purchased?</a></div></footer>
<script is:inline src="/analytics.js"></script><script>import '../scripts/monitoring.js';</script>
</body></html>
