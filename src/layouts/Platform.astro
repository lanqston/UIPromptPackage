---
import '../styles/global.css';
import '../styles/platform.css';
import '../styles/community-refresh.css';
const { title = 'Build. Share. Connect.', description = 'A space to discover useful ideas, share what you’re building, and connect with people creating something of their own.' } = Astro.props;
const links = [['/', 'Home'], ['/discover', 'Explore'], ['/resources', 'Resources'], ['/ui-ux-prompt-packet', 'Prompt Packet']];
const footerLinks = [...links, ['/products', 'Products'], ['/submit-project', 'Submit Project'], ['/about', 'About']];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = href => path === href || (href !== '/' && path.startsWith(href + '/'));
const social = [['X @digivatedx', 'https://x.com/digivatedx'], ['Threads @digivated', 'https://www.threads.com/@digivated'], ['Instagram @digivated', 'https://www.instagram.com/digivated/'], ['Pinterest @digivated', 'https://www.pinterest.com/digivated/']];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title} · Digivated</title><meta name="description" content={description}/><meta name="theme-color" content="#030712"/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={new URL(path, 'https://digivated.vercel.app')}/><meta property="og:title" content={`${title} · Digivated`}/><meta property="og:description" content={description}/><meta property="og:image" content="https://digivated.vercel.app/digivated-logo-site.jpg"/></head>
<body class:list={['platform', { 'home-refresh': path === '/' }]}><a class="skip" href="#main">Skip to content</a>
<header class="platform-header">
  <a class="platform-brand" href="/" aria-label="Digivated home"><span class="logo-crop"><img src="/digivated-logo-site.jpg" width="32" height="32" alt=""/></span><span>DIGIVATED</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
  <div class="header-actions"><a class="header-sign-in" href="/access">Sign In</a><a class="button primary header-submit" href="/submit-project">Submit Project</a></div>
  <details class="mobile-menu"><summary aria-controls="platform-mobile-navigation">Menu <span class="menu-glyph" aria-hidden="true"></span></summary><nav id="platform-mobile-navigation" aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}<a href="/access">Sign In</a><a href="/products">Products</a><a href="/about">About</a></nav></details>
</header>
<main id="main" tabindex="-1"><slot/></main>
<footer class="platform-footer"><div><a class="platform-brand" href="/"><span class="logo-crop"><img src="/digivated-logo-site.jpg" width="44" height="44" alt="Digivated logo"/></span>DIGIVATED</a><p>Build. Share. Connect.</p><p class="quiet">For people creating something of their own.</p></div><nav aria-label="Footer navigation"><span class="tiny">Explore</span>{footerLinks.filter(([href])=>href!=='/').map(([href,label])=><a href={href}>{label}</a>)}</nav><nav aria-label="Social links"><span class="tiny">Find us elsewhere</span>{social.map(([label,href])=><a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}</nav><div class="footer-bottom"><span>© {new Date().getFullYear()} Digivated</span><a href="/access">UI/UX Prompt Packet · Already purchased?</a></div></footer>
<script is:inline src="/analytics.js"></script><script>import '../scripts/monitoring.js'; import '../scripts/platform-ui.js';</script>
</body></html>

