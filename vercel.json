{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run monitoring:deploy && node scripts/verify-sentry.mjs && node scripts/verify-x-publisher.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/x-research.js": {
      "maxDuration": 300
    },
    "api/x-publish.js": {
      "maxDuration": 120
    },
    "api/*.js": {
      "includeFiles": "server/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cglkjclolglwizwepvmy.supabase.co https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://cglkjclolglwizwepvmy.supabase.co wss://cglkjclolglwizwepvmy.supabase.co https://o4512195501228032.ingest.us.sentry.io https://*.google-analytics.com https://www.googletagmanager.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "digitalpromptpackage.vercel.app"
        }
      ],
      "destination": "https://digivated.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "digivated.vercel.app"
        }
      ],
      "destination": "https://digivated.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "digivated.vercel.app"
        }
      ],
      "destination": "https://digivated.com/:path*",
      "permanent": true
    },
    {
      "source": "/about-langston",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "digitalpromptpackage.vercel.app"
        }
      ],
      "destination": "https://digivated.com/:path*",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/chat",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/members",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/profile",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/settings",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/moderate",
      "destination": "https://digivated.com/",
      "permanent": false
    },
    {
      "source": "/community/alerts",
      "destination": "https://digivated.com/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/x-research",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/x-publish",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/projects/:slug",
      "destination": "/api/project-page?slug=:slug"
    }
  ]
}
